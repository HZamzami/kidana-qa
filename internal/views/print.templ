package views

import (
	"context"
	"fmt"
	"time"

	"github.com/HZamzami/kidana-quality/internal/dates"
	"github.com/HZamzami/kidana-quality/internal/db/gen"
	"github.com/HZamzami/kidana-quality/internal/domain"
)

// ---------------------------------------------------------------- data

// PrintItem is one rated criterion on a printed inspection.
type PrintItem struct {
	Code, Label, Note string
	LabelEn           string
	Weight            int
	Critical          bool
	Rating            domain.Rating
}

// PrintAttempt is an earlier attempt of the same stage, listed for traceability.
type PrintAttempt struct {
	Attempt int
	Score   float64
	Passed  bool
}

// PrintInspection is the latest submitted attempt of one stage.
type PrintInspection struct {
	Stage          domain.Stage
	Attempt        int
	Inspector      string
	Date           time.Time
	Score          float64
	Passed         bool
	CriticalFailed bool
	Notes          string
	Items          []PrintItem
	History        []PrintAttempt // earlier attempts, oldest first
}

// WOPrintCard is one work order on its own A4 page.
type WOPrintCard struct {
	WO           gen.ListWorkOrdersForPrintRow
	During       *PrintInspection
	After        *PrintInspection
	Findings     []gen.ListFindingsForWorkOrdersRow
	OpenFindings int
	Verdict      domain.Verdict
}

// WOPrintData is a print run: one work order, or every work order in a filter.
type WOPrintData struct {
	Cards     []WOPrintCard
	Total     int // matching work orders; more than len(Cards) when capped
	Scope     string
	Back      string
	Printed   time.Time
	PrintedBy string
}

func (d WOPrintData) title(ctx context.Context) string {
	if len(d.Cards) == 1 {
		return t(ctx, "أمر العمل ") + d.Cards[0].WO.Ref
	}
	return t(ctx, "أوامر العمل — ") + count(ctx, len(d.Cards), domain.NounWorkOrder)
}

func (d WOPrintData) today() string { return d.Printed.Format(time.DateOnly) }

// signer is who signs for Kidana: the inspector of the latest after-work
// inspection, else of the during-work one.
func (c WOPrintCard) signer() string {
	if c.After != nil {
		return c.After.Inspector
	}
	if c.During != nil {
		return c.During.Inspector
	}
	return ""
}

// riyadh returns a timestamp as a Riyadh calendar date, for display.
func riyadh(t time.Time) *time.Time {
	r := t.In(dates.Riyadh)
	return &r
}

func attemptText(ctx context.Context, in *PrintInspection) string {
	return tf(ctx, "المحاولة %d من %d", in.Attempt, len(in.History)+1)
}

// ---------------------------------------------------------------- page
templ WorkOrdersPrint(d WOPrintData) {
	@Base(d.title(ctx)) {
		<div class="print-root" x-data="printPage" data-auto={ tern(len(d.Cards) > 0, "1", "0") }>
			<div class="no-print sticky top-0 z-10 bg-white border-b border-ink-10 shadow-sm">
				<div class="mx-auto max-w-[210mm] px-4 py-3 flex flex-wrap items-center gap-3">
					<img src={ asset("/static/img/kidana-logo.png") } alt={ t(ctx, "كدانة") } class="h-8 w-auto"/>
					<div class="min-w-0">
						<p class="font-semibold">{ d.title(ctx) }</p>
						<p class="text-xs text-ink-80">
							if d.Scope != "" {
								{ d.Scope }
							} else if len(d.Cards) > 1 {
								{ t(ctx, "كل أوامر العمل") }
							}
							if len(d.Cards) > 1 {
								<span class="text-ink-60">{ t(ctx, " · كل أمر عمل في صفحة A4 مستقلة") }</span>
							}
						</p>
					</div>
					<div class="ms-auto flex gap-2">
						<a href={ templ.SafeURL(d.Back) } class="btn btn-ghost">{ t(ctx, "رجوع") }</a>
						if len(d.Cards) > 0 {
							<button type="button" class="btn btn-primary" @click="print">{ t(ctx, "طباعة / حفظ PDF") }</button>
						}
					</div>
				</div>
				if d.Total > len(d.Cards) {
					<p class="mx-auto max-w-[210mm] px-4 pb-3 text-xs text-fail">
						{ fmt.Sprintf(t(ctx, "تُعرض أحدث %d من أصل %d أمر عمل مطابق. ضيّق الفلاتر لطباعة الباقي."), len(d.Cards), d.Total) }
					</p>
				}
				if len(d.Cards) > 0 {
					<p class="mx-auto max-w-[210mm] px-4 pb-3 text-[11px] text-ink-60">{ t(ctx, "للحفظ PDF اختر «حفظ بتنسيق PDF» من نافذة الطباعة، واجعل الهوامش «افتراضية» والمقياس 100%.") }</p>
				}
			</div>
			if len(d.Cards) == 0 {
				<div class="mx-auto max-w-[210mm] p-4">
					<div class="card">
						@EmptyState(t(ctx, "لا توجد أوامر عمل مطابقة للطباعة"), t(ctx, "غيّر الفلاتر في قائمة أوامر العمل ثم أعد المحاولة."))
					</div>
				</div>
			}
			<div class="sheets">
				for _, c := range d.Cards {
					@printSheet(d, c)
				}
			</div>
		</div>
	}
}

templ printSheet(d WOPrintData, c WOPrintCard) {
	<article class="sheet" aria-label={ t(ctx, "أمر العمل ") + c.WO.Ref }>
		<!-- header: identity of the record -->
		<header class="flex items-start gap-4 pb-3 border-b-2 border-gold">
			<img src={ asset("/static/img/kidana-logo.png") } alt={ t(ctx, "كدانة") } class="h-12 w-auto shrink-0"/>
			<div class="min-w-0 pt-0.5">
				<p class="pr-label">{ t(ctx, "إدارة جودة العمليات · قطاع العمليات") }</p>
				<h1 class="text-[15pt] font-bold leading-tight">{ t(ctx, "تقرير فحص أمر العمل") }</h1>
				<p class="pr-label mt-0.5">{ t(ctx, "فحص أثناء التنفيذ وفحص بعد التنفيذ") }</p>
			</div>
			<div class="ms-auto text-end">
				<p class="pr-label">{ t(ctx, domain.Label(domain.WOTypeLabels, string(c.WO.Type))) }</p>
				<p class="text-[19pt] font-bold leading-none num whitespace-nowrap" dir="ltr">{ c.WO.Ref }</p>
				<div class="mt-1.5 flex justify-end gap-1">
					@PriorityPill(string(c.WO.Priority))
					@WOStatusPill(string(c.WO.Status))
				</div>
			</div>
		</header>
		<!-- results at a glance -->
		<section class="mt-3 grid grid-cols-[1.35fr_1fr_1fr_0.8fr] gap-2 print-avoid-break" aria-label={ t(ctx, "النتيجة") }>
			<div
				class={ "rounded-lg border p-2.5",
					templ.KV("bg-green-10 border-green-50", c.Verdict.Tone == "good"),
					templ.KV("bg-fail-10 border-fail-20", c.Verdict.Tone == "bad"),
					templ.KV("bg-gold-10 border-gold-50", c.Verdict.Tone == "warn"),
					templ.KV("bg-ink-5 border-ink-10", c.Verdict.Tone == "neutral") }
			>
				<p class="pr-label">{ t(ctx, "النتيجة النهائية") }</p>
				<p
					class={ "mt-1 text-[12.5pt] font-bold leading-snug",
						templ.KV("text-green", c.Verdict.Tone == "good"),
						templ.KV("text-fail", c.Verdict.Tone == "bad") }
				>
					@verdictIcon(c.Verdict.Tone)
					{ t(ctx, c.Verdict.Label) }
				</p>
				<p class="mt-1 text-[7.5pt] text-ink-80">{ t(ctx, "يُعتمد أمر العمل عند نجاح آخر فحص بعد التنفيذ وإغلاق جميع الملاحظات.") }</p>
			</div>
			@scoreBox(domain.StageDuring, c.During)
			@scoreBox(domain.StageAfter, c.After)
			<div class="rounded-lg border border-ink-10 p-2.5">
				<p class="pr-label">{ t(ctx, "الملاحظات") }</p>
				<p class={ "mt-1 text-[17pt] font-bold leading-none num", templ.KV("text-fail", c.OpenFindings > 0) }>{ itoa(c.OpenFindings) }</p>
				<p class="mt-1 text-[7.5pt] text-ink-80">
					{ t(ctx, "مفتوحة من أصل ") + itoa(len(c.Findings)) }
				</p>
			</div>
		</section>
		<!-- work order details -->
		<section class="mt-3 print-avoid-break" aria-label={ t(ctx, "بيانات أمر العمل") }>
			<h2 class="pr-h2">{ t(ctx, "بيانات أمر العمل") }</h2>
			<dl class="pr-facts">
				@printFact(t(ctx, "الموقع")) {
					{ nm(ctx, c.WO.SiteName, c.WO.SiteNameEn) }
				}
				@printFact(t(ctx, "الموقع التفصيلي")) {
					{ orDash(c.WO.Location) }
				}
				@printFact(t(ctx, "المنظومة")) {
					{ nm(ctx, c.WO.SystemName, c.WO.SystemNameEn) }
				}
				@printFact(t(ctx, "مجموعة الأصل")) {
					{ nm(ctx, c.WO.AssetGroupName, c.WO.AssetGroupNameEn) }
				}
				@printFact(t(ctx, "الأصل / المعدة")) {
					<span dir="auto">{ orDash(c.WO.Asset) }</span>
				}
				@printFact(t(ctx, "المقاول")) {
					{ orDash(nm(ctx, c.WO.ContractorName, c.WO.ContractorNameEn)) }
				}
				@printFact(t(ctx, "الفني")) {
					{ orDash(c.WO.Technician) }
				}
				@printFact(t(ctx, "الأولوية")) {
					{ t(ctx, domain.Label(domain.PriorityLabels, string(c.WO.Priority))) }
				}
				@printFact(tern(c.WO.Type == gen.WoTypeWO, t(ctx, "استحقاق SLA"), t(ctx, "التاريخ المجدول"))) {
					@printDate(c.WO.PlannedDate)
				}
				@printFact(t(ctx, "التنفيذ الفعلي")) {
					@printDate(c.WO.ActualDate)
				}
				@printFact(t(ctx, "الالتزام بالموعد")) {
					{ delayText(ctx, c.WO.PlannedDate, c.WO.ActualDate) }
				}
				@printFact(t(ctx, "تاريخ التسجيل")) {
					@printDate(riyadh(c.WO.CreatedAt))
				}
			</dl>
			if c.WO.Description != "" {
				<p class="mt-1.5 rounded-md bg-ink-5 px-2.5 py-1.5"><span class="pr-label me-1">{ t(ctx, "وصف العمل:") }</span>{ c.WO.Description }</p>
			}
		</section>
		<!-- inspections side by side: during, then after -->
		<section class="mt-3 grid grid-cols-2 gap-3" aria-label={ t(ctx, "الفحوصات") }>
			@inspectionPanel(domain.StageDuring, c.During)
			@inspectionPanel(domain.StageAfter, c.After)
		</section>
		<!-- findings -->
		<section class="mt-3" aria-label={ t(ctx, "الملاحظات والإجراءات التصحيحية") }>
			<h2 class="pr-h2">{ t(ctx, "الملاحظات والإجراءات التصحيحية") }</h2>
			if len(c.Findings) == 0 {
				<p class="rounded-md border border-dashed border-ink-30 px-2.5 py-2 text-ink-80">{ t(ctx, "لا توجد ملاحظات مسجلة على أمر العمل.") }</p>
			} else {
				<table class="pr-table">
					<thead>
						<tr>
							<th class="w-6">#</th>
							<th class="w-20">{ t(ctx, "المرحلة / البند") }</th>
							<th>{ t(ctx, "الملاحظة والإجراء التصحيحي") }</th>
							<th class="w-24">{ t(ctx, "المسؤول") }</th>
							<th class="w-20">{ t(ctx, "الاستحقاق") }</th>
							<th class="w-16">{ t(ctx, "الحالة") }</th>
						</tr>
					</thead>
					<tbody>
						for i, f := range c.Findings {
							<tr class="print-avoid-break">
								<td class="text-center num">{ itoa(i + 1) }</td>
								<td>
									if f.InspectionStage != "" {
										<span class="block">{ t(ctx, domain.Stage(f.InspectionStage).Short()) }</span>
									}
									if f.CriterionCode != "" {
										<span class="num text-ink-80">{ f.CriterionCode }</span>
									}
								</td>
								<td>
									if f.Severity == gen.FindingSeverityCritical {
										<span class="pr-tag bg-fail-10 text-fail me-1">{ t(ctx, "حرجة") }</span>
									}
									<span class="font-medium">{ f.Description }</span>
									<span class="block text-ink-80"><span class="text-ink-60">{ t(ctx, "الإجراء:") } </span>{ f.CorrectiveAction }</span>
								</td>
								<td>{ orDash(f.Owner) }</td>
								<td>
									@printDate(f.DueDate)
								</td>
								<td>
									@findingState(f, d.today())
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</section>
		<!-- sign-off -->
		<section class="mt-4 grid grid-cols-3 gap-3 print-avoid-break" aria-label={ t(ctx, "الاعتماد") }>
			@signBox(t(ctx, "المفتش"), c.signer())
			@signBox(t(ctx, "ممثل المقاول"), nm(ctx, c.WO.ContractorName, c.WO.ContractorNameEn))
			@signBox(t(ctx, "اعتماد إدارة الجودة"), "")
		</section>
		<footer class="mt-auto pt-3">
			<div class="flex items-center gap-3 border-t border-ink-10 pt-1.5 text-[7pt] text-ink-60">
				<span>{ t(ctx, "سجل جودة — يُحفظ ضمن سجلات إدارة جودة العمليات") }</span>
				<span class="mx-auto">
					{ t(ctx, "طُبع في ") }
					<span class="num">{ dates.DMYTime(d.Printed) }</span>
					{ " · " }
					<span class="num">{ dates.HijriDigits(d.Printed) }</span>
					{ t(ctx, " هـ") }
					if d.PrintedBy != "" {
						{ t(ctx, " · بواسطة ") + d.PrintedBy }
					}
				</span>
				<span class="num" dir="ltr">{ c.WO.Ref }</span>
			</div>
		</footer>
	</article>
}

// ---------------------------------------------------------------- pieces
templ printFact(label string) {
	<div class="pr-fact">
		<dt>{ label }</dt>
		<dd>
			{ children... }
		</dd>
	</div>
}

// printDate is dd/mm/yyyy with the Hijri date beneath, sized for print.
templ printDate(tm *time.Time) {
	if tm == nil {
		<span class="text-ink-60">—</span>
	} else {
		<span class="num">{ dmy(*tm) }</span>
		<span class="block text-[7pt] text-ink-60"><span class="num">{ dates.HijriDigits(*tm) }</span> { t(ctx, "هـ") }</span>
	}
}

templ scoreBox(stage domain.Stage, in *PrintInspection) {
	<div class={ "rounded-lg border p-2.5 border-t-4", templ.KV("border-ink-10 border-t-sky", stage == domain.StageDuring), templ.KV("border-ink-10 border-t-gold", stage == domain.StageAfter) }>
		<p class="pr-label">{ t(ctx, stage.Label()) }</p>
		if in == nil {
			<p class="mt-1 text-[11pt] font-medium text-ink-60">{ t(ctx, "لم يُسجَّل") }</p>
		} else {
			<p class="mt-1 flex items-baseline gap-1.5">
				<span class={ "text-[17pt] font-bold leading-none num", templ.KV("text-green", in.Passed), templ.KV("text-fail", !in.Passed) }>{ scoreVal(in.Score) }</span>
				<span class="text-[8pt] text-ink-80">{ t(ctx, domain.GradeFor(in.Score)) }</span>
			</p>
			<p class="mt-1 text-[7.5pt] text-ink-80">
				@resultWord(in.Passed)
				{ " · " + attemptText(ctx, in) }
			</p>
		}
	</div>
}

templ inspectionPanel(stage domain.Stage, in *PrintInspection) {
	<div class="min-w-0 print-avoid-break">
		<h2 class="pr-h2 flex items-center gap-1.5">
			<span class={ "inline-block size-2 rounded-full", templ.KV("bg-sky", stage == domain.StageDuring), templ.KV("bg-gold", stage == domain.StageAfter) }></span>
			{ t(ctx, stage.Label()) }
		</h2>
		if in == nil {
			<p class="rounded-md border border-dashed border-ink-30 px-2.5 py-3 text-ink-80">
				{ t(ctx, "لم يُسجَّل فحص مرسل لهذه المرحلة.") }
			</p>
		} else {
			<p class="mb-1 text-[7.5pt] text-ink-80">
				{ t(ctx, "المفتش: ") + in.Inspector + " · " }<span class="num">{ dmy(in.Date) }</span>{ " (" }<span class="num">{ dates.HijriDigits(in.Date) }</span>{ t(ctx, " هـ) · ") + attemptText(ctx, in) }
			</p>
			if len(in.History) > 0 {
				<p class="mb-1 text-[7.5pt] text-ink-60">
					{ t(ctx, "سبقتها:") }
					for i, h := range in.History {
						if i > 0 {
							{ t(ctx, "، ") }
						}
						{ fmt.Sprintf(t(ctx, "المحاولة %d "), h.Attempt) }
						<span class="num">{ "(" + scoreVal(h.Score) + ")" }</span>
						{ " " + tern(h.Passed, t(ctx, "مطابق"), t(ctx, "غير مطابق")) }
					}
				</p>
			}
			if in.CriticalFailed {
				<p class="mb-1 rounded bg-fail-10 px-2 py-1 text-[8pt] font-medium text-fail">{ t(ctx, "إخفاق في بند حرج: الفحص غير مطابق بصرف النظر عن النتيجة.") }</p>
			}
			<table class="pr-table">
				<thead>
					<tr>
						<th class="w-7">{ t(ctx, "الرمز") }</th>
						<th>{ t(ctx, "البند") }</th>
						<th class="w-8 text-center">{ t(ctx, "الوزن") }</th>
						<th class="w-[5.6rem]">{ t(ctx, "التقييم") }</th>
					</tr>
				</thead>
				<tbody>
					for _, it := range in.Items {
						<tr>
							<td class="num text-ink-80">{ it.Code }</td>
							<td>
								{ nm(ctx, it.Label, it.LabelEn) }
								if it.Critical {
									<span class="pr-tag bg-ink-10 text-ink ms-0.5">{ t(ctx, "حرج") }</span>
								}
								if it.Note != "" {
									<span class="block text-[7pt] text-ink-80">{ it.Note }</span>
								}
							</td>
							<td class="num text-center">{ itoa(it.Weight) }</td>
							<td>
								@ratingCell(it.Rating)
							</td>
						</tr>
					}
				</tbody>
				<tfoot>
					<tr>
						<td colspan="2" class="font-medium">{ t(ctx, "النتيجة") }</td>
						<td colspan="2" class={ "font-bold num", templ.KV("text-green", in.Passed), templ.KV("text-fail", !in.Passed) }>
							{ scoreVal(in.Score) + " · " + t(ctx, domain.GradeFor(in.Score)) }
						</td>
					</tr>
				</tfoot>
			</table>
			if in.Notes != "" {
				<p class="mt-1 text-[7.5pt] text-ink-80"><span class="text-ink-60">{ t(ctx, "ملاحظات المفتش:") } </span>{ in.Notes }</p>
			}
		}
	</div>
}

// ratingCell pairs the label with a shape, so the result reads in black and
// white too: check, half, cross, dash.
templ ratingCell(r domain.Rating) {
	<span
		class={ "pr-rating",
			templ.KV("bg-green-10 text-green", r == domain.RatingCompliant),
			templ.KV("bg-gold-10 text-ink", r == domain.RatingPartial),
			templ.KV("bg-fail-10 text-fail", r == domain.RatingNonCompliant),
			templ.KV("bg-ink-5 text-ink-80", r == domain.RatingNA || r == "") }
	>
		switch r {
			case domain.RatingCompliant:
				<svg viewBox="0 0 12 12" class="size-[9px] shrink-0" aria-hidden="true"><path d="M2 6.5 5 9.2 10 3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
			case domain.RatingPartial:
				<svg viewBox="0 0 12 12" class="size-[9px] shrink-0" aria-hidden="true"><circle cx="6" cy="6" r="4.6" fill="none" stroke="currentColor" stroke-width="1.4"></circle><path d="M6 1.4a4.6 4.6 0 0 1 0 9.2z" fill="currentColor"></path></svg>
			case domain.RatingNonCompliant:
				<svg viewBox="0 0 12 12" class="size-[9px] shrink-0" aria-hidden="true"><path d="M3 3l6 6M9 3 3 9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
			default:
				<svg viewBox="0 0 12 12" class="size-[9px] shrink-0" aria-hidden="true"><path d="M3 6h6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
		}
		if r == "" {
			{ t(ctx, "غير مقيّم") }
		} else {
			{ t(ctx, r.ShortLabel()) }
		}
	</span>
}

templ resultWord(passed bool) {
	if passed {
		<span class="font-medium text-green">{ t(ctx, "مطابق") }</span>
	} else {
		<span class="font-medium text-fail">{ t(ctx, "غير مطابق") }</span>
	}
}

templ verdictIcon(tone string) {
	switch tone {
		case "good":
			<svg viewBox="0 0 12 12" class="inline-block size-[11px] me-1 align-[-1px]" aria-hidden="true"><path d="M2 6.5 5 9.2 10 3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
		case "bad":
			<svg viewBox="0 0 12 12" class="inline-block size-[11px] me-1 align-[-1px]" aria-hidden="true"><path d="M3 3l6 6M9 3 3 9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
	}
}

templ findingState(f gen.ListFindingsForWorkOrdersRow, today string) {
	<span class="block">{ t(ctx, domain.Label(domain.FindingStatusLabels, string(f.Status))) }</span>
	if f.Status == gen.FindingStatusClosed && f.ClosedAt != nil {
		<span class="block text-[7pt] text-ink-60 num">{ dmy(f.ClosedAt.In(dates.Riyadh)) }</span>
	} else if f.Status != gen.FindingStatusClosed && f.DueDate != nil && isoDate(f.DueDate) < today {
		<span class="pr-tag bg-fail-10 text-fail">{ t(ctx, "متأخرة") }</span>
	}
}

templ signBox(role, name string) {
	<div class="rounded-lg border border-ink-10 p-2.5">
		<p class="pr-label">{ role }</p>
		<p class="mt-1 min-h-[1.5em] font-medium">{ name }</p>
		<div class="mt-5 grid grid-cols-2 gap-3 text-[7.5pt] text-ink-60">
			<span class="border-t border-ink-30 pt-0.5">{ t(ctx, "التوقيع") }</span>
			<span class="border-t border-ink-30 pt-0.5">{ t(ctx, "التاريخ") }</span>
		</div>
	</div>
}

// ---------------------------------------------------------------- findings list (A4 landscape)

type FindingsPrintData struct {
	Rows      []gen.ListFindingsRow
	Scope     string
	Back      string
	Printed   time.Time
	PrintedBy string
}

templ FindingsPrint(d FindingsPrintData) {
	@Base(t(ctx, "الملاحظات والإجراءات التصحيحية")) {
		<div class="print-root" x-data="printPage" data-auto={ tern(len(d.Rows) > 0, "1", "0") }>
			<div class="no-print sticky top-0 z-10 bg-white border-b border-ink-10 shadow-sm">
				<div class="mx-auto max-w-[297mm] px-4 py-3 flex flex-wrap items-center gap-3">
					<img src={ asset("/static/img/kidana-logo.png") } alt={ t(ctx, "كدانة") } class="h-8 w-auto"/>
					<div class="min-w-0">
						<p class="font-semibold">{ t(ctx, "الملاحظات والإجراءات التصحيحية") + " — " + count(ctx, len(d.Rows), domain.NounFinding) }</p>
						if d.Scope != "" {
							<p class="text-xs text-ink-80">{ d.Scope }</p>
						}
					</div>
					<div class="ms-auto flex gap-2">
						<a href={ templ.SafeURL(d.Back) } class="btn btn-ghost">{ t(ctx, "رجوع") }</a>
						if len(d.Rows) > 0 {
							<button type="button" class="btn btn-primary" @click="print">{ t(ctx, "طباعة / حفظ PDF") }</button>
						}
					</div>
				</div>
			</div>
			<div class="sheets">
				<article class="sheet sheet-landscape">
					<header class="flex items-center gap-4 pb-3 border-b-2 border-gold">
						<img src={ asset("/static/img/kidana-logo.png") } alt={ t(ctx, "كدانة") } class="h-10 w-auto"/>
						<div>
							<p class="pr-label">{ t(ctx, "إدارة جودة العمليات · قطاع العمليات") }</p>
							<h1 class="text-[14pt] font-bold leading-tight">{ t(ctx, "الملاحظات والإجراءات التصحيحية") }</h1>
						</div>
						<div class="ms-auto text-end text-[8pt] text-ink-80">
							<p>{ count(ctx, len(d.Rows), domain.NounFinding) }</p>
							if d.Scope != "" {
								<p>{ d.Scope }</p>
							}
						</div>
					</header>
					if len(d.Rows) == 0 {
						<p class="mt-6 text-ink-80">{ t(ctx, "لا توجد ملاحظات ضمن هذا العرض") }</p>
					} else {
						<table class="pr-table mt-3">
							<thead>
								<tr>
									<th class="w-6">#</th>
									<th class="w-20">{ t(ctx, "أمر العمل") }</th>
									<th class="w-24">{ t(ctx, "الموقع") }</th>
									<th class="w-28">{ t(ctx, "المقاول") }</th>
									<th>{ t(ctx, "الملاحظة والإجراء التصحيحي") }</th>
									<th class="w-24">{ t(ctx, "المسؤول") }</th>
									<th class="w-20">{ t(ctx, "الاستحقاق") }</th>
									<th class="w-20">{ t(ctx, "الحالة") }</th>
								</tr>
							</thead>
							<tbody>
								for i, f := range d.Rows {
									<tr class="print-avoid-break">
										<td class="num text-center">{ itoa(i + 1) }</td>
										<td class="num">{ f.WoRef }</td>
										<td>{ nm(ctx, f.SiteName, f.SiteNameEn) }</td>
										<td>{ orDash(nm(ctx, f.ContractorName, f.ContractorNameEn)) }</td>
										<td>
											if f.Severity == gen.FindingSeverityCritical {
												<span class="pr-tag bg-fail-10 text-fail me-1">{ t(ctx, "حرجة") }</span>
											}
											if f.RepeatOf != nil {
												<span class="pr-tag bg-fail-10 text-fail me-1">{ t(ctx, "متكررة") }</span>
											}
											if f.CriterionCode != "" {
												<span class="num text-ink-80 me-1">{ f.CriterionCode }</span>
											}
											<span class="font-medium">{ f.Description }</span>
											<span class="block text-ink-80"><span class="text-ink-60">{ t(ctx, "الإجراء:") } </span>{ f.CorrectiveAction }</span>
										</td>
										<td>{ orDash(ownerName(f.OwnerUserName, f.Owner)) }</td>
										<td>
											@printDate(f.DueDate)
										</td>
										<td>
											<span class="block">{ t(ctx, domain.Label(domain.FindingStatusLabels, string(f.Status))) }</span>
											if f.Status != gen.FindingStatusClosed && f.DueDate != nil && isoDate(f.DueDate) < d.Printed.Format(time.DateOnly) {
												<span class="pr-tag bg-fail-10 text-fail">{ t(ctx, "متأخرة") }</span>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					}
					<footer class="mt-auto pt-3">
						<div class="flex items-center gap-3 border-t border-ink-10 pt-1.5 text-[7pt] text-ink-60">
							<span>{ t(ctx, "سجل جودة — يُحفظ ضمن سجلات إدارة جودة العمليات") }</span>
							<span class="mx-auto">
								{ t(ctx, "طُبع في ") }
								<span class="num">{ dates.DMYTime(d.Printed) }</span>
								if d.PrintedBy != "" {
									{ t(ctx, " · بواسطة ") + d.PrintedBy }
								}
							</span>
						</div>
					</footer>
				</article>
			</div>
		</div>
	}
}
