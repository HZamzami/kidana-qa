package views

import (
	"github.com/HZamzami/kidana-quality/internal/appctx"
	"github.com/HZamzami/kidana-quality/internal/domain"
)

// Base is the HTML document shell.
templ Base(title string) {
	<!DOCTYPE html>
	<html lang="ar" dir="rtl">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="theme-color" content="#4C4F53"/>
			<meta name="htmx-config" content='{"includeIndicatorStyles":false,"allowEval":false,"allowScriptTags":false}'/>
			<title>{ title } · نظام جودة الصيانة</title>
			<link rel="icon" type="image/png" href={ asset("/static/img/favicon.png") }/>
			<link rel="preload" href="/static/fonts/avenir-next-arabic-400.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="stylesheet" href={ asset("/static/css/app.css") }/>
			<script defer src={ asset("/static/js/htmx.min.js") }></script>
			<script defer src={ asset("/static/js/app.js") }></script>
			<script defer src={ asset("/static/js/alpine-csp.min.js") }></script>
		</head>
		<body class="min-h-dvh">
			{ children... }
			<div
				id="toast"
				role="status"
				aria-live="polite"
				hidden
				class="fixed bottom-6 inset-x-0 mx-auto w-fit max-w-[90vw] z-50 rounded-xl bg-ink text-white px-4 py-2.5 text-sm shadow-lg data-[tone=ok]:bg-green data-[tone=warn]:bg-fail"
			></div>
		</body>
	</html>
}

type navItem struct {
	href  string
	label string
	admin bool
}

var nav = []navItem{
	{"/", "لوحة المؤشرات", false},
	{"/work-orders", "أوامر العمل", false},
	{"/findings", "الملاحظات", false},
	{"/data", "البيانات والتقارير", false},
	{"/admin", "الإعدادات", true},
}

// App is the authenticated page shell: header, navigation and content.
templ App(title string) {
	@Base(title) {
		<header class="bg-white border-b border-ink-10 no-print">
			<div class="mx-auto max-w-7xl px-4 sm:px-6">
				<div class="flex items-center gap-4 py-3">
					<a href="/" class="flex items-center gap-3 min-w-0">
						<img src={ asset("/static/img/kidana-logo.png") } alt="كدانة" class="h-8 sm:h-9 w-auto shrink-0"/>
						<span class="hidden md:block border-s border-ink-10 ps-3 leading-tight">
							<span class="block font-semibold text-[15px]">نظام جودة الصيانة</span>
							<span class="block text-xs text-ink-80">إدارة جودة العمليات · قطاع العمليات</span>
						</span>
					</a>
					<div class="ms-auto">
						@userMenu()
					</div>
				</div>
				<nav class="-mb-px flex gap-1 overflow-x-auto" aria-label="القائمة الرئيسية">
					for _, n := range nav {
						if !n.admin || appctx.IsAdmin(ctx) {
							<a
								href={ templ.URL(n.href) }
								class={ "whitespace-nowrap px-3 py-2.5 text-sm border-b-2 transition-colors",
									templ.KV("border-gold text-ink font-semibold", isActive(appctx.Path(ctx), n.href)),
									templ.KV("border-transparent text-ink-80 hover:text-ink", !isActive(appctx.Path(ctx), n.href)) }
								if isActive(appctx.Path(ctx), n.href) {
									aria-current="page"
								}
							>{ n.label }</a>
						}
					}
				</nav>
			</div>
		</header>
		<main class="mx-auto max-w-7xl px-4 sm:px-6 py-6">
			@flashBanner()
			{ children... }
		</main>
		<footer class="mx-auto max-w-7xl px-4 sm:px-6 pb-8 pt-2 text-xs text-ink-60 no-print">
			شركة كدانة للتنمية والتطوير · إدارة جودة العمليات
		</footer>
	}
}

templ userMenu() {
	if user := appctx.User(ctx); user != nil {
		<div class="relative" x-data="disclosure" x-on:click.outside="close" x-on:keydown.escape="close">
			<button type="button" class="btn btn-ghost px-2" x-on:click="toggle" aria-haspopup="true" x-bind:aria-expanded="open">
				<span class="grid place-items-center size-8 rounded-full bg-gold-20 text-ink font-semibold">{ initial(user.Name) }</span>
				<span class="hidden sm:block text-start leading-tight">
					<span class="block text-sm text-ink">{ user.Name }</span>
					<span class="block text-[11px] text-ink-60">{ domain.Label(domain.RoleLabels, string(user.Role)) }</span>
				</span>
			</button>
			<div x-show="open" x-cloak class="absolute end-0 mt-2 w-52 card shadow-lg p-1 z-30">
				<a href="/account/password" class="block rounded-md px-3 py-2 hover:bg-ink-5">تغيير كلمة المرور</a>
				<form method="post" action="/logout">
					<button type="submit" class="w-full text-start rounded-md px-3 py-2 hover:bg-ink-5">تسجيل الخروج</button>
				</form>
			</div>
		</div>
	}
}

templ flashBanner() {
	if f := appctx.FlashFrom(ctx); f != nil {
		<div
			role="status"
			class={ "mb-5 rounded-lg border px-4 py-3 text-sm",
				templ.KV("border-green-50 bg-green-10 text-green", f.Tone == "ok"),
				templ.KV("border-fail-20 bg-fail-10 text-fail", f.Tone == "warn"),
				templ.KV("border-ink-10 bg-white", f.Tone != "ok" && f.Tone != "warn") }
		>{ f.Message }</div>
	}
}

// PageHeader is the title row of a page with optional actions.
templ PageHeader(title, subtitle string) {
	<div class="mb-5 flex flex-wrap items-end gap-3">
		<div class="min-w-0">
			<h1 class="text-xl font-semibold text-balance">{ title }</h1>
			if subtitle != "" {
				<p class="text-ink-80 text-sm mt-0.5">{ subtitle }</p>
			}
		</div>
		<div class="ms-auto flex flex-wrap gap-2">
			{ children... }
		</div>
	</div>
}

templ ErrorPage(status int, message string) {
	if appctx.User(ctx) != nil {
		@App("خطأ") {
			@errorBody(status, message)
		}
	} else {
		@Base("خطأ") {
			<main class="mx-auto max-w-md px-4 py-16">
				@errorBody(status, message)
			</main>
		}
	}
}

templ errorBody(status int, message string) {
	<div class="card p-8 text-center">
		<p class="num text-4xl font-semibold text-gold">{ itoa(status) }</p>
		<p class="mt-3 text-ink-80">{ message }</p>
		<a href="/" class="btn btn-outline mt-6">العودة للرئيسية</a>
	</div>
}
