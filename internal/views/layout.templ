package views

import (
	"context"

	"github.com/HZamzami/kidana-quality/internal/appctx"
	"github.com/HZamzami/kidana-quality/internal/domain"
)

// Base is the HTML document shell.
templ Base(title string) {
	<!DOCTYPE html>
	<html lang={ string(appctx.Lang(ctx)) } dir={ appctx.Lang(ctx).Dir() }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="theme-color" content="#4C4F53"/>
			<meta name="htmx-config" content='{"includeIndicatorStyles":false,"allowEval":false,"allowScriptTags":false}'/>
			<title>{ title } { t(ctx, "· نظام جودة الصيانة") }</title>
			<link rel="icon" type="image/png" href={ asset("/static/img/favicon.png") }/>
			<link rel="manifest" href="/manifest.webmanifest"/>
			<link rel="apple-touch-icon" href="/static/img/apple-touch-icon.png"/>
			<link rel="preload" href="/static/fonts/avenir-next-arabic-400.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="stylesheet" href={ asset("/static/css/app.css") }/>
			<script defer src={ asset("/static/js/htmx.min.js") }></script>
			<script defer src={ asset("/static/js/app.js") }></script>
			<script defer src={ asset("/static/js/alpine-csp.min.js") }></script>
		</head>
		<body class="min-h-dvh">
			{ children... }
			<div
				id="toast"
				role="status"
				aria-live="polite"
				hidden
				class="fixed bottom-6 inset-x-0 mx-auto w-fit max-w-[90vw] z-50 rounded-xl bg-ink text-white px-4 py-2.5 text-sm shadow-lg data-[tone=ok]:bg-green data-[tone=warn]:bg-fail"
			></div>
		</body>
	</html>
}

// navItem is a main navigation tab. who: "" everyone, "staff" not
// contractors, "tasks" editors and contractors, "admin" admins only.
type navItem struct {
	href  string
	label string
	who   string
}

var nav = []navItem{
	{"/", "لوحة المؤشرات", "staff"},
	{"/my/tasks", "مهامي", "tasks"},
	{"/work-orders", "أوامر العمل", ""},
	{"/findings", "الملاحظات", ""},
	{"/assets", "الأصول", "staff"},
	{"/contractors", "أداء المقاولين", "staff"},
	{"/contractors", "أداء المقاول", "contractor"},
	{"/data", "البيانات والتقارير", "staff"},
	{"/admin", "الإعدادات", "admin"},
}

func navVisible(ctx context.Context, n navItem) bool {
	switch n.who {
	case "staff":
		return !appctx.IsContractor(ctx)
	case "tasks":
		return appctx.CanEdit(ctx) || appctx.IsContractor(ctx)
	case "admin":
		return appctx.IsAdmin(ctx)
	case "contractor":
		return appctx.IsContractor(ctx)
	}
	return true
}

// App is the authenticated page shell: header, navigation and content.
templ App(title string) {
	@Base(title) {
		<header class="bg-white border-b border-ink-10 no-print">
			<div class="mx-auto max-w-7xl px-4 sm:px-6">
				<div class="flex items-center gap-4 py-3">
					<a href="/" class="flex items-center gap-3 min-w-0">
						<img src={ asset("/static/img/kidana-logo.png") } alt={ t(ctx, "كدانة") } class="h-8 sm:h-9 w-auto shrink-0"/>
						<span class="hidden md:block border-s border-ink-10 ps-3 leading-tight">
							<span class="block font-semibold text-[15px]">{ t(ctx, "نظام جودة الصيانة") }</span>
							<span class="block text-xs text-ink-80">{ t(ctx, "إدارة جودة العمليات · قطاع العمليات") }</span>
						</span>
					</a>
					<div class="ms-auto flex items-center gap-1">
						<form method="get" action="/search" class="hidden md:block no-print" role="search">
							<input class="input h-9 w-44 lg:w-56" type="search" name="q" placeholder={ t(ctx, "بحث برقم أو رمز…") } aria-label={ t(ctx, "بحث") }/>
						</form>
						<a href="/search" class="btn btn-ghost px-2 md:hidden" aria-label={ t(ctx, "بحث") }>
							<svg viewBox="0 0 20 20" class="size-5" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="9" cy="9" r="5.5"></circle><path d="M13 13l4 4"></path></svg>
						</a>
						@LangToggle()
						@bellSlot()
						@userMenu()
					</div>
				</div>
				<nav class="-mb-px hidden md:flex gap-1 overflow-x-auto" aria-label={ t(ctx, "القائمة الرئيسية") }>
					for _, n := range nav {
						if navVisible(ctx, n) {
							<a
								href={ templ.URL(n.href) }
								class={ "whitespace-nowrap px-3 py-2.5 text-sm border-b-2 transition-colors",
									templ.KV("border-gold text-ink font-semibold", isActive(appctx.Path(ctx), n.href)),
									templ.KV("border-transparent text-ink-80 hover:text-ink", !isActive(appctx.Path(ctx), n.href)) }
								if isActive(appctx.Path(ctx), n.href) {
									aria-current="page"
								}
							>{ t(ctx, n.label) }</a>
						}
					}
				</nav>
			</div>
		</header>
		<main class="mx-auto max-w-7xl px-4 sm:px-6 py-6 pb-24 md:pb-6">
			@flashBanner()
			{ children... }
		</main>
		<footer class="mx-auto max-w-7xl px-4 sm:px-6 pb-8 pt-2 text-xs text-ink-60 no-print">
			{ t(ctx, "شركة كدانة للتنمية والتطوير · إدارة جودة العمليات") }
		</footer>
		@phoneNav()
	}
}

// bellSlot loads the notification bell after the page (keeps pages fast).
templ bellSlot() {
	<span hx-get="/notifications/bell" hx-trigger="load" hx-swap="outerHTML">
		@Bell(0)
	</span>
}

templ userMenu() {
	if user := appctx.User(ctx); user != nil {
		<div class="relative" x-data="disclosure" x-on:click.outside="close" x-on:keydown.escape="close">
			<button type="button" class="btn btn-ghost px-2" x-on:click="toggle" aria-haspopup="true" x-bind:aria-expanded="open">
				<span class="grid place-items-center size-8 rounded-full bg-gold-20 text-ink font-semibold">{ initial(user.Name) }</span>
				<span class="hidden sm:block text-start leading-tight">
					<span class="block text-sm text-ink">{ user.Name }</span>
					<span class="block text-[11px] text-ink-60">{ t(ctx, domain.Label(domain.RoleLabels, string(user.Role))) }</span>
				</span>
			</button>
			<div x-show="open" x-cloak class="absolute end-0 mt-2 w-52 card shadow-lg p-1 z-30">
				<a href="/account/security" class="block rounded-md px-3 py-2 hover:bg-ink-5">{ t(ctx, "الأمان والتحقق بخطوتين") }</a>
				<a href="/account/password" class="block rounded-md px-3 py-2 hover:bg-ink-5">{ t(ctx, "تغيير كلمة المرور") }</a>
				<form method="post" action="/logout">
					<button type="submit" class="w-full text-start rounded-md px-3 py-2 hover:bg-ink-5">{ t(ctx, "تسجيل الخروج") }</button>
				</form>
			</div>
		</div>
	}
}

// LangToggle switches between Arabic and English. It posts to /lang and
// returns to the same page.
templ LangToggle() {
	<form method="post" action="/lang" class="no-print">
		<input type="hidden" name="lang" value={ string(appctx.Lang(ctx).Other()) }/>
		if uri := appctx.ReturnURI(ctx); uri != "" {
			<input type="hidden" name="next" value={ uri }/>
		}
		<button type="submit" class="btn btn-ghost px-2.5" lang={ string(appctx.Lang(ctx).Other()) } title={ t(ctx, "تغيير اللغة") }>
			<svg viewBox="0 0 20 20" class="size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10" cy="10" r="7.5"></circle><path d="M2.5 10h15M10 2.5c2.2 2.3 2.2 12.7 0 15M10 2.5c-2.2 2.3-2.2 12.7 0 15"></path></svg>
			{ appctx.Lang(ctx).Other().Name() }
		</button>
	</form>
}

templ flashBanner() {
	if f := appctx.FlashFrom(ctx); f != nil {
		<div
			role="status"
			class={ "mb-5 rounded-lg border px-4 py-3 text-sm",
				templ.KV("border-green-50 bg-green-10 text-green", f.Tone == "ok"),
				templ.KV("border-fail-20 bg-fail-10 text-fail", f.Tone == "warn"),
				templ.KV("border-ink-10 bg-white", f.Tone != "ok" && f.Tone != "warn") }
		>{ t(ctx, f.Message) }</div>
	}
}

// PageHeader is the title row of a page with optional actions.
templ PageHeader(title, subtitle string) {
	<div class="mb-5 flex flex-wrap items-end gap-3">
		<div class="min-w-0">
			<h1 class="text-xl font-semibold text-balance">{ title }</h1>
			if subtitle != "" {
				<p class="text-ink-80 text-sm mt-0.5">{ subtitle }</p>
			}
		</div>
		<div class="ms-auto flex flex-wrap gap-2">
			{ children... }
		</div>
	</div>
}

templ ErrorPage(status int, message string) {
	if appctx.User(ctx) != nil {
		@App(t(ctx, "خطأ")) {
			@errorBody(status, message)
		}
	} else {
		@Base(t(ctx, "خطأ")) {
			<main class="mx-auto max-w-md px-4 py-16">
				@errorBody(status, message)
			</main>
		}
	}
}

templ errorBody(status int, message string) {
	<div class="card p-8 text-center">
		<p class="num text-4xl font-semibold text-gold">{ itoa(status) }</p>
		<p class="mt-3 text-ink-80">{ t(ctx, message) }</p>
		<a href="/" class="btn btn-outline mt-6">{ t(ctx, "العودة للرئيسية") }</a>
	</div>
}

templ OfflinePage() {
	@Base(t(ctx, "غير متصل")) {
		<main class="mx-auto max-w-md px-4 py-16">
			<div class="card p-8 text-center">
				<img src="/static/img/icon-192.png" alt="" class="size-16 mx-auto"/>
				<h1 class="mt-4 text-lg font-semibold">{ t(ctx, "لا يوجد اتصال") }</h1>
				<p class="mt-2 text-ink-80">{ t(ctx, "هذه الصفحة غير محفوظة على الجوال. الصفحات التي فتحتها من قبل (مهامي، أوامر العمل، الفحوصات) تعمل دون اتصال، وتُرسل تعديلاتك عند عودة الاتصال.") }</p>
				<a href="/my/tasks" class="btn btn-primary mt-6">{ t(ctx, "مهامي") }</a>
			</div>
		</main>
	}
}

// phoneTab is a bottom-bar tab on phones.
type phoneTab struct {
	href, label, icon, who string
}

var phoneTabs = []phoneTab{
	{"/", "لوحة المؤشرات", "M3 10.5 10 4l7 6.5V17h-4.5v-4h-5v4H3z", "staff"},
	{"/my/tasks", "مهامي", "M5 5h10M5 10h10M5 15h6M3 5h.01M3 10h.01M3 15h.01", "tasks"},
	{"/work-orders", "أوامر العمل", "M6 3h8l2 2v12H4V3zM7 8h6M7 11h6M7 14h4", ""},
	{"/findings", "الملاحظات", "M10 3 2.5 16.5h15zM10 8v4M10 14.5h.01", ""},
}

// phoneNav is the fixed bottom tab bar on phones; «المزيد» opens the rest.
templ phoneNav() {
	<nav class="md:hidden no-print fixed bottom-0 inset-x-0 z-30 bg-white border-t border-ink-10 pb-[env(safe-area-inset-bottom)]" aria-label={ t(ctx, "القائمة الرئيسية") } x-data="disclosure">
		<div class="grid grid-cols-5">
			for _, tb := range phoneTabs {
				if navVisible(ctx, navItem{href: tb.href, who: tb.who}) {
					<a
						href={ templ.URL(tb.href) }
						class={ "flex flex-col items-center gap-0.5 py-2 text-[11px]", templ.KV("text-gold font-semibold", isActive(appctx.Path(ctx), tb.href)), templ.KV("text-ink-80", !isActive(appctx.Path(ctx), tb.href)) }
						if isActive(appctx.Path(ctx), tb.href) {
							aria-current="page"
						}
					>
						<svg viewBox="0 0 20 20" class="size-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ tb.icon }></path></svg>
						<span class="truncate max-w-full px-1">{ t(ctx, tb.label) }</span>
					</a>
				}
			}
			<button type="button" class="flex flex-col items-center gap-0.5 py-2 text-[11px] text-ink-80" x-on:click="toggle" x-bind:aria-expanded="open">
				<svg viewBox="0 0 20 20" class="size-5" fill="currentColor" aria-hidden="true"><circle cx="4.5" cy="10" r="1.5"></circle><circle cx="10" cy="10" r="1.5"></circle><circle cx="15.5" cy="10" r="1.5"></circle></svg>
				<span>{ t(ctx, "المزيد") }</span>
			</button>
		</div>
		<div x-show="open" x-cloak x-on:click.outside="close" class="absolute bottom-full inset-x-0 mb-1 mx-2 card shadow-lg p-1">
			for _, n := range nav {
				if navVisible(ctx, n) && !onPhoneBar(n.href) {
					<a href={ templ.URL(n.href) } class="block rounded-md px-3 py-2.5 hover:bg-ink-5">{ t(ctx, n.label) }</a>
				}
			}
			<a href="/notifications" class="block rounded-md px-3 py-2.5 hover:bg-ink-5">{ t(ctx, "التنبيهات") }</a>
		</div>
	</nav>
}

func onPhoneBar(href string) bool {
	for _, tb := range phoneTabs {
		if tb.href == href {
			return true
		}
	}
	return false
}
