package views

import (
	"fmt"

	"github.com/HZamzami/kidana-quality/internal/db/gen"
	"github.com/HZamzami/kidana-quality/internal/domain"
)

templ adminNav(active string) {
	<nav class="flex flex-wrap gap-2 mb-5">
		for _, it := range []Option{{"/admin/checklists", t(ctx, "قوائم الفحص")}, {"/admin/lookups/sites", t(ctx, "المواقع")}, {"/admin/lookups/systems", t(ctx, "المنظومات")}, {"/admin/lookups/asset-groups", t(ctx, "مجموعات الأصول")}, {"/admin/lookups/contractors", t(ctx, "المقاولون")}, {"/admin/users", t(ctx, "المستخدمون")}, {"/admin/sampling", t(ctx, "قواعد العينة")}, {"/admin/sla", t(ctx, "زمن الحل والتقييم")}, {"/admin/audit", t(ctx, "سجل التغييرات")}, {"/admin/api", t(ctx, "الربط مع الأنظمة")}} {
			<a href={ templ.URL(it.Value) } class={ "btn", templ.KV("btn-primary", active == it.Value), templ.KV("btn-outline", active != it.Value) }>{ t(ctx, it.Label) }</a>
		}
	</nav>
}

templ AdminHome() {
	@App(t(ctx, "الإعدادات")) {
		@PageHeader(t(ctx, "الإعدادات"), t(ctx, "إدارة قوائم الفحص والبيانات المرجعية والمستخدمين"))
		<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			@adminCard("/admin/checklists", t(ctx, "قوائم الفحص"), t(ctx, "بنود الفحص أثناء التنفيذ والفحص بعد التنفيذ وأوزانها. أي تعديل يُنشئ إصداراً جديداً ولا يغيّر نتائج سابقة."))
			@adminCard("/admin/lookups/sites", t(ctx, "المواقع"), t(ctx, "منى، عرفات، مزدلفة…"))
			@adminCard("/admin/lookups/systems", t(ctx, "المنظومات"), t(ctx, "التكييف والتبريد، الكهرباء، مكافحة الحريق…"))
			@adminCard("/admin/lookups/asset-groups", t(ctx, "مجموعات الأصول"), t(ctx, "المبردات، المضخات، لوحات التوزيع…"))
			@adminCard("/admin/lookups/contractors", t(ctx, "المقاولون"), t(ctx, "الجهات المنفذة وبيانات التواصل."))
			@adminCard("/admin/users", t(ctx, "المستخدمون"), t(ctx, "الحسابات والصلاحيات: مدير، مدقق، مشاهد، مقاول."))
			@adminCard("/admin/sampling", t(ctx, "قواعد العينة"), t(ctx, "أي أوامر العمل الجديدة يُسند لها فحص تلقائياً، حسب النوع والأولوية."))
			@adminCard("/admin/sla", t(ctx, "زمن الحل والتقييم"), t(ctx, "الأيام المستهدفة لحل أوامر العمل وإغلاق الملاحظات، وأوزان تقييم المقاولين."))
			@adminCard("/admin/audit", t(ctx, "سجل التغييرات"), t(ctx, "من غيّر ماذا ومتى في كل أوامر العمل والفحوصات والإعدادات."))
			@adminCard("/admin/api", t(ctx, "الربط مع الأنظمة"), t(ctx, "مفاتيح API لمزامنة أوامر العمل مع نظام إدارة الصيانة دون Excel."))
		</div>
	}
}

templ adminCard(href, title, desc string) {
	<a href={ templ.URL(href) } class="card p-5 hover:border-gold-50 transition-colors">
		<div class="font-semibold">{ title }</div>
		<p class="text-sm text-ink-80 mt-1">{ desc }</p>
	</a>
}

// ---------------------------------------------------------------- lookups

type LookupRow struct {
	ID          int64
	Name        string
	NameEn      string
	Sort        int32
	Active      bool
	ContactName string
	Phone       string
}

type LookupData struct {
	Kind    string // sites | systems | asset-groups | contractors
	Title   string
	Rows    []LookupRow
	Errors  map[string]string
	NewName string
}

func (d LookupData) isContractors() bool { return d.Kind == "contractors" }

templ LookupPage(d LookupData) {
	@App(t(ctx, d.Title)) {
		@PageHeader(t(ctx, d.Title), "")
		@adminNav("/admin/lookups/" + d.Kind)
		<form method="post" action={ u("/admin/lookups/%s", d.Kind) } class="card p-4 mb-4 flex flex-wrap items-end gap-3" novalidate>
			<div class="flex-1 min-w-48">
				@TextField("name", t(ctx, "إضافة جديد"), d.NewName, true, d.Errors, templ.Attributes{"maxlength": "120"})
			</div>
			<div class="flex-1 min-w-48">
				@TextField("name_en", t(ctx, "الاسم بالإنجليزية (اختياري)"), "", false, d.Errors, templ.Attributes{"maxlength": "120", "dir": "ltr", "lang": "en"})
			</div>
			if d.isContractors() {
				<div class="min-w-40">
					@TextField("contact_name", t(ctx, "جهة الاتصال"), "", false, d.Errors, nil)
				</div>
				<div class="min-w-36">
					@TextField("phone", t(ctx, "الهاتف"), "", false, d.Errors, templ.Attributes{"dir": "ltr"})
				</div>
			} else {
				<div class="w-24">
					@TextField("sort", t(ctx, "الترتيب"), "0", false, d.Errors, templ.Attributes{"type": "number"})
				</div>
			}
			<button type="submit" class="btn btn-primary">{ t(ctx, "إضافة") }</button>
		</form>
		<div class="card overflow-hidden">
			<div class="overflow-x-auto">
				<table class="table">
					<thead><tr><th>{ count(ctx, len(d.Rows), domain.NounEntry) + t(ctx, " — عدّل مباشرة ثم احفظ الصف") }</th></tr></thead>
					<tbody>
						for _, row := range d.Rows {
							<tr>
								<td class="p-0">
									<form method="post" action={ u("/admin/lookups/%s/%d", d.Kind, row.ID) } class="flex flex-wrap items-center gap-2 px-3 py-2">
										<input class="input h-9 flex-1 min-w-40" name="name" value={ row.Name } aria-label={ t(ctx, "الاسم") } required maxlength="120"/>
										<input class="input h-9 flex-1 min-w-40" name="name_en" value={ row.NameEn } aria-label={ t(ctx, "الاسم بالإنجليزية (اختياري)") } placeholder="English name" maxlength="120" dir="ltr" lang="en"/>
										if d.isContractors() {
											<input class="input h-9 w-40" name="contact_name" value={ row.ContactName } aria-label={ t(ctx, "جهة الاتصال") }/>
											<input class="input h-9 w-36" name="phone" value={ row.Phone } aria-label={ t(ctx, "الهاتف") } dir="ltr"/>
										} else {
											<input class="input h-9 w-20" type="number" name="sort" value={ itoa(int(row.Sort)) } aria-label={ t(ctx, "الترتيب") }/>
										}
										<label class="flex items-center gap-1.5 text-sm px-2">
											<input type="checkbox" name="active" value="on" checked?={ row.Active } class="size-4"/>
											{ t(ctx, "مفعّل") }
										</label>
										<button type="submit" class="btn btn-outline py-1.5">{ t(ctx, "حفظ") }</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
		<p class="mt-3 text-xs text-ink-60">{ t(ctx, "لا يُحذف أي عنصر مستخدم في أوامر عمل سابقة؛ ألغِ تفعيله ليختفي من النماذج الجديدة.") }</p>
	}
}

// ---------------------------------------------------------------- users

type UsersData struct {
	Users       []gen.User
	Requests    []gen.ListOpenPasswordResetRequestsRow // «نسيت كلمة المرور» awaiting an admin
	Errors      map[string]string
	New         struct{ Email, Name, Role, ContractorID string }
	Contractors []Option
	Info        string // e.g. a generated temporary password to hand over
	ResetLink   string // a one-time reset link to hand over, shown once
	ResetFor    string
}

func roleOptions() []Option {
	out := make([]Option, 0, len(domain.RoleOrder))
	for _, r := range domain.RoleOrder {
		out = append(out, Option{r, domain.RoleLabels[r]})
	}
	return out
}

templ UsersPage(d UsersData) {
	@App(t(ctx, "المستخدمون")) {
		@PageHeader(t(ctx, "المستخدمون"), t(ctx, "المدقق يسجّل الفحوصات والملاحظات، والمشاهد يطّلع فقط، والمقاول يرد على ملاحظات أعماله، والمدير يدير الإعدادات."))
		@adminNav("/admin/users")
		if d.Info != "" {
			<div role="status" class="mb-4 rounded-lg border border-gold-50 bg-gold-10 px-4 py-3 text-sm">{ d.Info }</div>
		}
		if d.ResetLink != "" {
			<div role="status" class="mb-4 rounded-lg border border-gold-50 bg-gold-10 px-4 py-3 text-sm space-y-2">
				<p>{ tf(ctx, "رابط إعادة تعيين كلمة المرور لـ %s — صالح 24 ساعة ولمرة واحدة. أرسله للمستخدم بنفسك؛ لن يظهر مرة أخرى.", d.ResetFor) }</p>
				<input class="input h-9 font-mono text-xs" dir="ltr" readonly value={ d.ResetLink } aria-label={ t(ctx, "رابط إعادة التعيين") }/>
			</div>
		}
		if len(d.Requests) > 0 {
			<section class="card p-4 mb-4 border-s-4 border-s-gold">
				<h2 class="font-semibold text-sm mb-2">{ t(ctx, "طلبات إعادة تعيين كلمة المرور") }</h2>
				<ul class="divide-y divide-ink-10">
					for _, rq := range d.Requests {
						<li class="flex flex-wrap items-center gap-3 py-2">
							<span class="font-medium">{ rq.Name }</span>
							<span class="text-xs text-ink-60" dir="ltr">{ rq.Email }</span>
							<span class="text-xs text-ink-60 num">{ dateTime(rq.CreatedAt) }</span>
							<form method="post" action={ u("/admin/users/%d/reset-link", rq.UserID) } class="ms-auto">
								<button type="submit" class="btn btn-primary py-1.5 text-xs">{ t(ctx, "إنشاء رابط إعادة تعيين") }</button>
							</form>
						</li>
					}
				</ul>
			</section>
		}
		<form method="post" action="/admin/users" class="card p-4 mb-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-6 items-end" novalidate>
			@TextField("name", t(ctx, "الاسم"), d.New.Name, true, d.Errors, templ.Attributes{"maxlength": "80"})
			@TextField("email", t(ctx, "البريد الإلكتروني"), d.New.Email, true, d.Errors, templ.Attributes{"type": "email", "dir": "ltr"})
			@SelectField("role", t(ctx, "الصلاحية"), tern(d.New.Role == "", "inspector", d.New.Role), roleOptions(), "", true, d.Errors)
			@SelectField("contractor_id", t(ctx, "المقاول (لحساب مقاول)"), d.New.ContractorID, d.Contractors, "—", false, d.Errors)
			@TextField("password", t(ctx, "كلمة مرور مؤقتة"), "", false, d.Errors, templ.Attributes{"type": "text", "dir": "ltr", "placeholder": t(ctx, "اتركها فارغة لتوليدها"), "autocomplete": "off"})
			<button type="submit" class="btn btn-primary">{ t(ctx, "إضافة مستخدم") }</button>
		</form>
		<div class="card overflow-hidden">
			<div class="overflow-x-auto">
				<table class="table">
					<thead><tr><th>{ count(ctx, len(d.Users), domain.NounUser) }</th></tr></thead>
					<tbody>
						for _, usr := range d.Users {
							<tr>
								<td class="p-0">
									<div class="flex flex-wrap items-center gap-2 px-3 py-2">
										<form method="post" action={ u("/admin/users/%d", usr.ID) } class="flex flex-wrap items-center gap-2 flex-1">
											<input class="input h-9 w-44" name="name" value={ usr.Name } aria-label={ t(ctx, "الاسم") } required maxlength="80"/>
											<input class="input h-9 w-56" name="email" value={ usr.Email } aria-label={ t(ctx, "البريد") } type="email" dir="ltr" required/>
											<select class="input h-9 w-36" name="role" aria-label={ t(ctx, "الصلاحية") }>
												for _, o := range roleOptions() {
													<option value={ o.Value } selected?={ o.Value == string(usr.Role) }>{ t(ctx, o.Label) }</option>
												}
											</select>
											<select class="input h-9 w-44" name="contractor_id" aria-label={ t(ctx, "المقاول (لحساب مقاول)") }>
												<option value="">—</option>
												for _, o := range d.Contractors {
													<option value={ o.Value } selected?={ usr.ContractorID != nil && o.Value == idStr(*usr.ContractorID) }>{ o.Label }</option>
												}
											</select>
											<label class="flex items-center gap-1.5 text-sm px-2">
												<input type="checkbox" name="active" value="on" checked?={ usr.Active } class="size-4"/>
												{ t(ctx, "مفعّل") }
											</label>
											<button type="submit" class="btn btn-outline py-1.5">{ t(ctx, "حفظ") }</button>
										</form>
										if usr.TotpEnabled {
											<span class="pill bg-green-10 text-green" title={ t(ctx, "التحقق بخطوتين مفعّل") }>2FA</span>
										}
										<form method="post" action={ u("/admin/users/%d/reset-link", usr.ID) }>
											<button type="submit" class="btn btn-ghost py-1.5 text-xs">{ t(ctx, "رابط إعادة تعيين") }</button>
										</form>
										<form method="post" action={ u("/admin/users/%d/password", usr.ID) }>
											<button type="submit" class="btn btn-ghost py-1.5 text-xs">{ t(ctx, "كلمة مرور مؤقتة جديدة") }</button>
										</form>
										if usr.TotpEnabled {
											<form method="post" action={ u("/admin/users/%d/2fa-reset", usr.ID) }>
												<button type="submit" class="btn btn-ghost py-1.5 text-xs text-fail">{ t(ctx, "إيقاف 2FA") }</button>
											</form>
										}
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}

// ---------------------------------------------------------------- checklists
templ ChecklistsPage(rows []gen.ListTemplatesRow) {
	@App(t(ctx, "قوائم الفحص")) {
		@PageHeader(t(ctx, "قوائم الفحص"), t(ctx, "قائمة واحدة مفعّلة لكل مرحلة. الفحوصات تحتفظ بالإصدار الذي استخدمته."))
		@adminNav("/admin/checklists")
		<div class="card overflow-hidden">
			<div class="overflow-x-auto">
				<table class="table">
					<thead><tr><th>{ t(ctx, "القائمة") }</th><th>{ t(ctx, "المرحلة") }</th><th>{ t(ctx, "الإصدار") }</th><th>{ t(ctx, "الحالة") }</th><th>{ t(ctx, "فحوصات") }</th><th></th></tr></thead>
					<tbody>
						for _, tpl := range rows {
							<tr>
								<td>
									<a class="underline decoration-gold-50 underline-offset-4" href={ u("/admin/checklists/%d", tpl.ID) }>{ checklistName(ctx, tpl.Name) }</a>
									<span class="block text-xs text-ink-60">
										if tpl.SystemName == "" && tpl.AssetGroupName == "" {
											{ t(ctx, "عامة") }
										} else {
											{ joinNonEmpty(" · ", nm(ctx, tpl.SystemName, tpl.SystemNameEn), nm(ctx, tpl.AssetGroupName, tpl.AssetGroupNameEn)) }
										}
									</span>
								</td>
								<td>
									@StagePill(string(tpl.Stage))
								</td>
								<td class="num">{ itoa(int(tpl.Version)) }</td>
								<td>
									if tpl.Active {
										<span class="pill bg-green-10 text-green">{ t(ctx, "مفعّلة") }</span>
									} else {
										<span class="pill bg-ink-5 text-ink-60">{ t(ctx, "غير مفعّلة") }</span>
									}
								</td>
								<td class="num">{ fmt.Sprint(tpl.InspectionsCount) }</td>
								<td>
									<a href={ u("/admin/checklists/%d/new-version", tpl.ID) } class="btn btn-outline py-1 text-xs">{ t(ctx, "إصدار جديد من هذه") }</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}

templ ChecklistShow(tpl gen.ChecklistTemplate, crits []gen.TemplateCriterion) {
	@App(checklistName(ctx, tpl.Name)) {
		@PageHeader(checklistName(ctx, tpl.Name), fmt.Sprintf(t(ctx, "%s · الإصدار %d"), t(ctx, domain.Stage(tpl.Stage).Label()), tpl.Version)) {
			<a href={ u("/admin/checklists/%d/new-version", tpl.ID) } class="btn btn-primary">{ t(ctx, "إصدار جديد من هذه") }</a>
		}
		@adminNav("/admin/checklists")
		<div class="card overflow-hidden">
			<table class="table">
				<thead><tr><th>{ t(ctx, "الرمز") }</th><th>{ t(ctx, "البند") }</th><th>{ t(ctx, "الوصف / طريقة التحقق") }</th><th>{ t(ctx, "الوزن") }</th></tr></thead>
				<tbody>
					for _, c := range crits {
						<tr>
							<td class="num">{ c.Code }</td>
							<td class="font-medium">
								{ nm(ctx, c.Label, c.LabelEn) }
								if c.IsCritical {
									<span class="pill border border-fail text-fail text-[10px] ms-1">{ t(ctx, "حرج") }</span>
								}
							</td>
							<td class="text-ink-80">{ nm(ctx, c.Description, c.DescriptionEn) }</td>
							<td class="num">{ itoa(int(c.Weight)) }</td>
						</tr>
					}
					<tr><td></td><td class="font-semibold">{ t(ctx, "المجموع") }</td><td></td><td class="num font-semibold">{ itoa(weightSum(crits)) }</td></tr>
				</tbody>
			</table>
		</div>
		<p class="mt-3 text-xs text-ink-60">{ t(ctx, "النتيجة = مجموع (الوزن × معامل التقييم) ÷ مجموع أوزان البنود المنطبقة × 100. المطابق 100%، الجزئي 50%، غير المطابق 0%، و«لا ينطبق» يُستبعد. حد المطابقة 80%، وأي بند حرج غير مطابق يُسقط الفحص.") }</p>
	}
}

func weightSum(cs []gen.TemplateCriterion) int {
	n := 0
	for _, c := range cs {
		n += int(c.Weight)
	}
	return n
}

type CriterionInput struct {
	Code, Label, Description, Weight string
	LabelEn, DescriptionEn           string
	Critical                         bool
}

type ChecklistFormData struct {
	Stage    string
	Name     string
	Activate bool
	// Scope: empty = general; a system and/or asset group makes it specific.
	SystemID, AssetGroupID string
	Systems, AssetGroups   []Option
	Rows                   []CriterionInput
	Errors                 []string
}

templ ChecklistForm(d ChecklistFormData) {
	@App(t(ctx, "إصدار جديد لقائمة الفحص")) {
		@PageHeader(t(ctx, "إصدار جديد — ")+t(ctx, domain.Stage(d.Stage).Label()), t(ctx, "الصفوف الفارغة تُتجاهل. الفحوصات السابقة لا تتأثر."))
		@adminNav("/admin/checklists")
		<form method="post" action="/admin/checklists" class="card p-5 space-y-4" novalidate>
			if len(d.Errors) > 0 {
				<div role="alert" class="rounded-lg bg-fail-10 border border-fail-20 text-fail text-sm px-3 py-2">
					<ul class="list-disc ps-5">
						for _, e := range d.Errors {
							<li>{ t(ctx, e) }</li>
						}
					</ul>
				</div>
			}
			<input type="hidden" name="stage" value={ d.Stage }/>
			<div class="max-w-md">
				<label class="label" for="cl_name">{ t(ctx, "اسم القائمة") }</label>
				<input class="input" id="cl_name" name="name" value={ d.Name } required maxlength="120"/>
			</div>
			<fieldset class="grid gap-3 sm:grid-cols-2 max-w-2xl">
				<legend class="label">{ t(ctx, "نطاق القائمة (اختياري)") }</legend>
				@SelectField("system_id", t(ctx, "المنظومة"), d.SystemID, d.Systems, t(ctx, "كل المنظومات"), false, nil)
				@SelectField("asset_group_id", t(ctx, "مجموعة الأصل"), d.AssetGroupID, d.AssetGroups, t(ctx, "كل مجموعات الأصول"), false, nil)
				<p class="sm:col-span-2 text-xs text-ink-60">{ t(ctx, "الفحص الجديد يستخدم أدق قائمة مفعّلة تطابق أمر العمل: مجموعة الأصل، ثم المنظومة، ثم القائمة العامة.") }</p>
			</fieldset>
			<div class="overflow-x-auto">
				<table class="table">
					<thead><tr><th class="w-20">{ t(ctx, "الرمز") }</th><th>{ t(ctx, "البند") }</th><th>{ t(ctx, "الوصف / طريقة التحقق") }</th><th class="w-20">{ t(ctx, "الوزن") }</th><th class="w-16">{ t(ctx, "حرج") }</th></tr></thead>
					<tbody>
						for i, row := range d.Rows {
							<tr>
								<td><input class="input h-9" name={ fmt.Sprintf("code_%d", i) } value={ row.Code } maxlength="10" aria-label={ t(ctx, "الرمز") }/></td>
								<td class="space-y-1.5">
									<input class="input h-9 min-w-48" name={ fmt.Sprintf("label_%d", i) } value={ row.Label } maxlength="120" aria-label={ t(ctx, "البند") }/>
									<input class="input h-9 min-w-48" name={ fmt.Sprintf("label_en_%d", i) } value={ row.LabelEn } maxlength="120" aria-label={ t(ctx, "البند بالإنجليزية (اختياري)") } placeholder="English (optional)" dir="ltr" lang="en"/>
								</td>
								<td class="space-y-1.5">
									<textarea class="input py-1.5 min-w-64" rows="2" name={ fmt.Sprintf("desc_%d", i) } aria-label={ t(ctx, "الوصف") }>{ row.Description }</textarea>
									<textarea class="input py-1.5 min-w-64" rows="2" name={ fmt.Sprintf("desc_en_%d", i) } aria-label={ t(ctx, "الوصف بالإنجليزية (اختياري)") } placeholder="English (optional)" dir="ltr" lang="en">{ row.DescriptionEn }</textarea>
								</td>
								<td><input class="input h-9" type="number" min="1" max="100" name={ fmt.Sprintf("weight_%d", i) } value={ row.Weight } aria-label={ t(ctx, "الوزن") }/></td>
								<td class="text-center"><input type="checkbox" class="size-4" name={ fmt.Sprintf("critical_%d", i) } value="on" checked?={ row.Critical } aria-label={ t(ctx, "بند حرج") }/></td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<input type="hidden" name="rows" value={ itoa(len(d.Rows)) }/>
			<label class="flex items-center gap-2 text-sm">
				<input type="checkbox" name="activate" value="on" checked?={ d.Activate } class="size-4"/>
				{ t(ctx, "تفعيل هذا الإصدار فوراً للفحوصات الجديدة") }
			</label>
			<div class="flex gap-2">
				<button type="submit" class="btn btn-primary">{ t(ctx, "حفظ الإصدار") }</button>
				<a href="/admin/checklists" class="btn btn-ghost">{ t(ctx, "إلغاء") }</a>
			</div>
		</form>
	}
}

// ---------------------------------------------------------------- resolution targets and scorecard weights

func slaLabel(key string) string {
	switch key {
	case "emergency":
		return "أمر عمل طارئ"
	case "high":
		return "أمر عمل عالي الأولوية"
	case "normal":
		return "أمر عمل عادي"
	case "finding_critical":
		return "ملاحظة حرجة"
	case "finding_normal":
		return "ملاحظة عادية"
	}
	return key
}

templ SLAPage(rows []gen.SlaTarget, w domain.ScoreWeights) {
	@App(t(ctx, "زمن الحل والتقييم")) {
		@PageHeader(t(ctx, "زمن الحل والتقييم"), t(ctx, "قيم افتراضية تحتاج تأكيد الإدارة. تُطبق على أوامر العمل والملاحظات الجديدة."))
		@adminNav("/admin/sla")
		<form method="post" action="/admin/sla" class="grid gap-5 lg:grid-cols-2">
			<section class="card p-5 space-y-3">
				<h2 class="font-semibold">{ t(ctx, "زمن الحل المستهدف (بالأيام)") }</h2>
				<p class="text-xs text-ink-80">{ t(ctx, "استحقاق أمر العمل = تاريخ البلاغ + أيام أولويته، إن لم يُدخل تاريخ مجدول. استحقاق الملاحظة = تاريخ تسجيلها + أيام أهميتها، إن لم يُدخل.") }</p>
				for _, r := range rows {
					<label class="flex items-center gap-3">
						<span class="flex-1 text-sm">{ t(ctx, slaLabel(r.Key)) }</span>
						<input class="input h-9 w-24" type="number" min="0" max="365" name={ "days_" + r.Key } value={ itoa(int(r.Days)) }/>
					</label>
				}
			</section>
			<section class="card p-5 space-y-3">
				<h2 class="font-semibold">{ t(ctx, "أوزان تقييم المقاولين (المجموع 100)") }</h2>
				<p class="text-xs text-ink-80">{ t(ctx, "التقييم المركب في صفحة المقاولين. الأجزاء غير المتاحة تُستبعد وتُعاد موازنة الباقي.") }</p>
				@weightInput("after", t(ctx, "متوسط الفحص بعد التنفيذ"), w.After)
				@weightInput("during", t(ctx, "متوسط الفحص أثناء التنفيذ"), w.During)
				@weightInput("sla", t(ctx, "الالتزام بزمن الحل"), w.SLA)
				@weightInput("findings", t(ctx, "إغلاق الملاحظات في موعدها"), w.Findings)
			</section>
			<button type="submit" class="btn btn-primary justify-self-start">{ t(ctx, "حفظ") }</button>
		</form>
	}
}

templ weightInput(key, label string, v int) {
	<label class="flex items-center gap-3">
		<span class="flex-1 text-sm">{ label }</span>
		<input class="input h-9 w-24" type="number" min="0" max="100" name={ "w_" + key } value={ itoa(v) }/>
	</label>
}

func joinNonEmpty(sep string, parts ...string) string {
	out := ""
	for _, p := range parts {
		if p == "" {
			continue
		}
		if out != "" {
			out += sep
		}
		out += p
	}
	return out
}

// ---------------------------------------------------------------- API tokens
templ APITokensPage(rows []gen.ListAPITokensRow, newToken, base string) {
	@App(t(ctx, "الربط مع الأنظمة")) {
		@PageHeader(t(ctx, "الربط مع الأنظمة"), t(ctx, "واجهة JSON لإنشاء أوامر العمل وتحديثها وقراءة نتائجها من نظام إدارة الصيانة."))
		@adminNav("/admin/api")
		if newToken != "" {
			<div role="status" class="mb-4 rounded-lg border border-gold-50 bg-gold-10 px-4 py-3 text-sm space-y-2">
				<p>{ t(ctx, "المفتاح الجديد — انسخه الآن وخزّنه في النظام المرتبط؛ لن يظهر مرة أخرى.") }</p>
				<input class="input h-9 font-mono text-xs" dir="ltr" readonly value={ newToken } aria-label={ t(ctx, "المفتاح") }/>
			</div>
		}
		<div class="grid gap-5 lg:grid-cols-5">
			<section class="lg:col-span-2 space-y-4">
				<form method="post" action="/admin/api" class="card p-4 flex flex-wrap items-end gap-2">
					<div class="flex-1 min-w-40">
						<label class="label" for="tok_name">{ t(ctx, "اسم المفتاح") }</label>
						<input class="input h-10" id="tok_name" name="name" maxlength="80" required placeholder={ t(ctx, "مثال: مزامنة Maximo") }/>
					</div>
					<button type="submit" class="btn btn-primary">{ t(ctx, "إنشاء مفتاح") }</button>
				</form>
				<div class="card overflow-hidden">
					if len(rows) == 0 {
						@EmptyState(t(ctx, "لا توجد مفاتيح"), "")
					} else {
						<ul class="divide-y divide-ink-10">
							for _, tk := range rows {
								<li class="flex flex-wrap items-center gap-2 px-4 py-3 text-sm">
									<span class={ "font-medium", templ.KV("line-through text-ink-60", tk.RevokedAt != nil) }>{ tk.Name }</span>
									<span class="text-xs text-ink-60">{ tk.CreatedByName }</span>
									if tk.LastUsedAt != nil {
										<span class="text-xs text-ink-60 num">{ t(ctx, "آخر استخدام ") + dateTime(*tk.LastUsedAt) }</span>
									}
									if tk.RevokedAt == nil {
										<form method="post" action={ u("/admin/api/%d/revoke", tk.ID) } class="ms-auto">
											<button type="submit" class="btn btn-ghost py-1 text-xs text-fail">{ t(ctx, "إلغاء") }</button>
										</form>
									}
								</li>
							}
						</ul>
					}
				</div>
			</section>
			<section class="lg:col-span-3 card p-5 text-sm space-y-3">
				<h2 class="font-semibold">{ t(ctx, "طريقة الاستخدام") }</h2>
				<p class="text-ink-80">{ t(ctx, "أرسل المفتاح في ترويسة Authorization. الأسماء (الموقع، المنظومة، مجموعة الأصل، المقاول) تُطابق كما في استيراد Excel، والأسماء الجديدة تُضاف.") }</p>
				<pre class="rounded-lg bg-ink text-white p-3 text-xs overflow-x-auto" dir="ltr">{ apiExample(base) }</pre>
			</section>
		</div>
	}
}

func apiExample(base string) string {
	return "# list work orders changed since a time (oldest first, up to 500)\n" +
		"curl -H 'Authorization: Bearer $TOKEN' '" + base + "/api/v1/work-orders?updated_since=2026-11-01T00:00:00Z'\n\n" +
		"# one work order with its status, scores and open findings\n" +
		"curl -H 'Authorization: Bearer $TOKEN' " + base + "/api/v1/work-orders/WO-2026-1001\n\n" +
		"# create or update by number\n" +
		"curl -X PUT -H 'Authorization: Bearer $TOKEN' -H 'Content-Type: application/json' \\\n" +
		"  " + base + "/api/v1/work-orders/WO-2026-1001 -d '{\n" +
		"  \"type\": \"WO\", \"priority\": \"high\",\n" +
		"  \"site\": \"<site>\", \"system\": \"<system>\", \"asset_group\": \"<asset group>\",\n" +
		"  \"asset\": \"PMP-MN-012\", \"contractor\": \"<contractor>\",\n" +
		"  \"description\": \"...\", \"reported_on\": \"2026-11-24\"\n}'"
}
