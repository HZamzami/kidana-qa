package views

import (
	"fmt"
	"net/url"

	"github.com/HZamzami/kidana-quality/internal/appctx"
	"github.com/HZamzami/kidana-quality/internal/db/gen"
	"github.com/HZamzami/kidana-quality/internal/domain"
)

// ---------------------------------------------------------------- list

type WOListData struct {
	Rows        []gen.ListWorkOrdersRow
	Total       int64
	Page        int
	PageSize    int
	Query       url.Values
	Sites       []Option
	Systems     []Option
	AssetGroups []Option
	Contractors []Option
	Statuses    []Option
	Priorities  []Option
	Views       ViewsBar
}

func (d WOListData) val(k string) string { return d.Query.Get(k) }

var slaOptions = []Option{{"breached", "تجاوز الهدف"}, {"at_risk", "قريب من الهدف"}}

// printURL prints every work order matching the current filters (not just this page).
func (d WOListData) printURL() templ.SafeURL {
	if enc := d.Query.Encode(); enc != "" {
		return templ.URL("/work-orders/print?" + enc)
	}
	return templ.URL("/work-orders/print")
}

func (d WOListData) Pages() int {
	if d.Total == 0 {
		return 1
	}
	return int((d.Total + int64(d.PageSize) - 1) / int64(d.PageSize))
}

templ WorkOrdersPage(d WOListData) {
	@App(t(ctx, "أوامر العمل")) {
		@PageHeader(t(ctx, "أوامر العمل"), t(ctx, "كل أمر عمل يجمع الفحص أثناء التنفيذ والفحص بعد التنفيذ والملاحظات")) {
			<a href="/work-orders" class="btn btn-ghost">{ t(ctx, "إعادة ضبط الفلاتر") }</a>
			if appctx.CanEdit(ctx) {
				<a href="/work-orders/new" class="btn btn-primary">{ t(ctx, "＋ أمر عمل جديد") }</a>
			}
		}
		@SavedViewsBar(d.Views)
		<form
			class="card p-3 mb-4 grid grid-cols-2 md:grid-cols-5 xl:grid-cols-10 items-end gap-3"
			method="get"
			action="/work-orders"
			hx-get="/work-orders"
			hx-trigger="change, input from:#flt_q delay:350ms"
			hx-target="#wo-results"
			hx-select="#wo-results"
			hx-swap="outerHTML"
			hx-push-url="true"
		>
			<div class="col-span-2 min-w-0">
				<label class="label" for="flt_q">{ t(ctx, "بحث") }</label>
				<input class="input h-9" type="search" id="flt_q" name="q" value={ d.val("q") } placeholder={ t(ctx, "رقم أمر العمل، الأصل، الموقع التفصيلي، الفني…") }/>
			</div>
			<!-- 10 cells: search spans two; even on phone, tablet (5) and wide (10) -->
			@FilterSelect("type", t(ctx, "النوع"), d.val("type"), TypeOptions)
			@FilterSelect("status", t(ctx, "الحالة"), d.val("status"), d.Statuses)
			@FilterSelect("priority", t(ctx, "الأولوية"), d.val("priority"), d.Priorities)
			@FilterSelect("sla", t(ctx, "زمن الحل"), d.val("sla"), slaOptions)
			@FilterSelect("site", t(ctx, "الموقع"), d.val("site"), d.Sites)
			@FilterSelect("system", t(ctx, "المنظومة"), d.val("system"), d.Systems)
			@FilterSelect("group", t(ctx, "مجموعة الأصل"), d.val("group"), d.AssetGroups)
			@FilterSelect("contractor", t(ctx, "المقاول"), d.val("contractor"), d.Contractors)
			<noscript><button class="btn btn-primary">{ t(ctx, "تطبيق") }</button></noscript>
		</form>
		@WorkOrdersResults(d)
	}
}

templ WorkOrdersResults(d WOListData) {
	<div id="wo-results" class="card overflow-hidden">
		if len(d.Rows) == 0 {
			@EmptyState(t(ctx, "لا توجد أوامر عمل مطابقة"), t(ctx, "غيّر الفلاتر أو أضف أمر عمل جديداً."))
		} else {
			<div class="flex flex-wrap items-center gap-3 px-3 py-2.5 border-b border-ink-10">
				<span class="text-xs text-ink-80">{ count(ctx, int(d.Total), domain.NounWorkOrder) }</span>
				<a
					class="btn btn-outline ms-auto py-1.5"
					href={ d.printURL() }
					target="_blank"
					rel="noopener"
					title={ t(ctx, "كل أمر عمل مطابق للفلاتر في صفحة A4 مستقلة") }
				>
					@PrintIcon()
					{ t(ctx, "طباعة النتائج PDF (") + itoa(int(d.Total)) + ")" }
				</a>
			</div>
			<div class="overflow-x-auto">
				<table class="table">
					<thead>
						<tr>
							<th>{ t(ctx, "رقم أمر العمل") }</th>
							<th>{ t(ctx, "النوع") }</th>
							<th>{ t(ctx, "الموقع") }</th>
							<th>{ t(ctx, "المنظومة / مجموعة الأصل") }</th>
							<th>{ t(ctx, "الأصل") }</th>
							<th>{ t(ctx, "المقاول") }</th>
							<th>{ t(ctx, "أثناء التنفيذ") }</th>
							<th>{ t(ctx, "بعد التنفيذ") }</th>
							<th>{ t(ctx, "ملاحظات مفتوحة") }</th>
							<th>{ t(ctx, "الحالة") }</th>
							<th class="relative w-0"><span class="sr-only">{ t(ctx, "إجراءات") }</span></th>
						</tr>
					</thead>
					<tbody>
						for _, w := range d.Rows {
							<tr>
								<td class="whitespace-nowrap">
									<a class="font-medium text-ink underline decoration-gold-50 underline-offset-4 hover:decoration-gold" href={ u("/work-orders/%d", w.ID) }>{ w.Ref }</a>
									if w.Priority != gen.WoPriorityNormal {
										<span class="ms-1">
											@PriorityPill(string(w.Priority))
										</span>
									}
									if w.DraftInspections > 0 {
										<span class="pill bg-sky-15 text-ink-80 ms-1">{ t(ctx, "مسودة") }</span>
									}
								</td>
								<td>
									@TypePill(string(w.Type))
								</td>
								<td class="whitespace-nowrap">{ nm(ctx, w.SiteName, w.SiteNameEn) }</td>
								<td class="whitespace-nowrap">
									{ nm(ctx, w.SystemName, w.SystemNameEn) }
									<span class="block text-xs text-ink-60">{ nm(ctx, w.AssetGroupName, w.AssetGroupNameEn) }</span>
								</td>
								<td class="max-w-40 truncate" title={ w.Asset }>{ orDash(w.Asset) }</td>
								<td class="max-w-40 truncate" title={ nm(ctx, w.ContractorName, w.ContractorNameEn) }>{ orDash(nm(ctx, w.ContractorName, w.ContractorNameEn)) }</td>
								<td>
									@ScoreBar(w.DuringScore, w.DuringScore >= domain.PassThreshold)
								</td>
								<td>
									@ScoreBar(w.AfterScore, w.AfterPassed)
								</td>
								<td class="num text-center">
									if w.OpenFindings > 0 {
										<span class="pill bg-fail-10 text-fail">{ itoa(int(w.OpenFindings)) }</span>
									} else {
										<span class="text-ink-60">0</span>
									}
								</td>
								<td class="space-y-1">
									@WOStatusPill(string(w.Status))
									<div>
										@SLAPill(slaState(w.PlannedDate, w.ActualDate, string(w.Status)))
									</div>
								</td>
								<td class="py-1">
									<a
										class="btn btn-ghost px-2 py-1.5"
										href={ u("/work-orders/%d/print", w.ID) }
										target="_blank"
										rel="noopener"
										title={ t(ctx, "طباعة ") + w.Ref }
										aria-label={ t(ctx, "طباعة أمر العمل ") + w.Ref }
									>
										@PrintIcon()
									</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			if d.Pages() > 1 {
				<div class="flex items-center gap-3 px-3 py-2.5 text-xs text-ink-80 border-t border-ink-10">
					<span class="ms-auto flex items-center gap-1">
						if d.Page > 1 {
							<a class="btn btn-ghost px-2 py-1" href={ templ.URL(withQuery("/work-orders", d.Query, "page", itoa(d.Page-1))) }>{ t(ctx, "السابق") }</a>
						}
						<span class="num">{ fmt.Sprintf("%d / %d", d.Page, d.Pages()) }</span>
						if d.Page < d.Pages() {
							<a class="btn btn-ghost px-2 py-1" href={ templ.URL(withQuery("/work-orders", d.Query, "page", itoa(d.Page+1))) }>{ t(ctx, "التالي") }</a>
						}
					</span>
				</div>
			}
		}
	</div>
}

// ---------------------------------------------------------------- form

type WOFormValues struct {
	Ref, Type, SiteID, Location, SystemID, AssetGroupID, Asset, ContractorID, Technician string
	Priority, Description, PlannedDate, ActualDate, Status, ReportedOn                   string
}

type WOFormData struct {
	ID          int64 // 0 = new
	V           WOFormValues
	Errors      map[string]string
	Sites       []Option
	Systems     []Option
	AssetGroups []Option
	Contractors []Option
	Priorities  []Option
	Statuses    []Option
}

templ WorkOrderForm(d WOFormData) {
	@App(tern(d.ID == 0, t(ctx, "أمر عمل جديد"), t(ctx, "تعديل أمر العمل"))) {
		if d.ID == 0 {
			@PageHeader(t(ctx, "أمر عمل جديد"), t(ctx, "سجّل أمر العمل أو الصيانة الوقائية كما هو في نظام إدارة الصيانة"))
		} else {
			@PageHeader(t(ctx, "تعديل أمر العمل ")+d.V.Ref, "") {
				<a href={ u("/work-orders/%d", d.ID) } class="btn btn-ghost">{ t(ctx, "رجوع") }</a>
			}
		}
		<form method="post" action={ templ.SafeURL(tern(d.ID == 0, "/work-orders", path("/work-orders/%d", d.ID))) } class="card p-5 sm:p-6" novalidate data-guard>
			if len(d.Errors) > 0 {
				<div role="alert" class="mb-5 rounded-lg bg-fail-10 border border-fail-20 text-fail text-sm px-3 py-2">{ t(ctx, "يرجى مراجعة الحقول المعلّمة.") }</div>
			}
			<fieldset class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				<legend class="sr-only">{ t(ctx, "بيانات العمل") }</legend>
				@SelectField("type", t(ctx, "النوع"), d.V.Type, TypeOptions, "", true, d.Errors)
				@TextField("ref", t(ctx, "رقم أمر العمل / الصيانة"), d.V.Ref, true, d.Errors, templ.Attributes{"maxlength": "60", "dir": "auto"})
				@SelectField("priority", t(ctx, "الأولوية"), d.V.Priority, d.Priorities, "", true, d.Errors)
				@SelectField("site_id", t(ctx, "الموقع"), d.V.SiteID, d.Sites, t(ctx, "اختر الموقع"), true, d.Errors)
				@TextField("location", t(ctx, "الموقع التفصيلي"), d.V.Location, false, d.Errors, templ.Attributes{"maxlength": "120", "placeholder": t(ctx, "المبنى / الدور / الغرفة")})
				@SelectField("system_id", t(ctx, "المنظومة"), d.V.SystemID, d.Systems, t(ctx, "اختر المنظومة"), true, d.Errors)
				@SelectField("asset_group_id", t(ctx, "مجموعة الأصل"), d.V.AssetGroupID, d.AssetGroups, t(ctx, "اختر مجموعة الأصل"), true, d.Errors)
				@TextField("asset", t(ctx, "الأصل / المعدة"), d.V.Asset, false, d.Errors, templ.Attributes{"maxlength": "120", "placeholder": t(ctx, "رمز أو اسم الأصل")})
				@SelectField("contractor_id", t(ctx, "المقاول / الجهة المنفذة"), d.V.ContractorID, d.Contractors, "—", false, d.Errors)
				@TextField("technician", t(ctx, "الفني"), d.V.Technician, false, d.Errors, templ.Attributes{"maxlength": "80"})
				@TextField("reported_on", t(ctx, "تاريخ البلاغ"), tern(d.V.ReportedOn == "", today(), d.V.ReportedOn), false, d.Errors, templ.Attributes{"type": "date"})
				@TextField("planned_date", t(ctx, "التاريخ المجدول / استحقاق SLA"), d.V.PlannedDate, false, d.Errors, templ.Attributes{"type": "date", "title": t(ctx, "يُحسب من الأولوية إن تُرك فارغاً")})
				@TextField("actual_date", t(ctx, "تاريخ التنفيذ الفعلي"), d.V.ActualDate, false, d.Errors, templ.Attributes{"type": "date"})
				if d.ID != 0 {
					@SelectField("status", t(ctx, "الحالة"), d.V.Status, d.Statuses, "", true, d.Errors)
				}
				<div class="sm:col-span-2 lg:col-span-3">
					@TextArea("description", t(ctx, "وصف العمل"), d.V.Description, 3, d.Errors)
				</div>
			</fieldset>
			if d.ID != 0 {
				<p class="mt-3 text-xs text-ink-60">{ t(ctx, "«معتمد» يُحدَّد تلقائياً عندما ينجح آخر فحص بعد التنفيذ ولا توجد ملاحظات مفتوحة.") }</p>
			}
			<div class="mt-6 flex gap-2">
				<button type="submit" class="btn btn-primary">{ t(ctx, "حفظ") }</button>
				if d.ID == 0 {
					<button type="submit" name="next" value="new" class="btn btn-outline">{ t(ctx, "حفظ وإضافة آخر") }</button>
				}
				<a href={ templ.SafeURL(tern(d.ID == 0, "/work-orders", path("/work-orders/%d", d.ID))) } class="btn btn-ghost">{ t(ctx, "إلغاء") }</a>
			</div>
		</form>
	}
}

// ---------------------------------------------------------------- detail

type WOShowData struct {
	WO          gen.GetWorkOrderRow
	Inspections []gen.ListInspectionsByWorkOrderRow
	Findings    []gen.ListFindingsByWorkOrderRow
	Assignments []gen.ListAssignmentsByWorkOrderRow
	History     []HistoryEntry
	Assignees   []Option // people an inspection can be assigned to
	Today       string
}

// deletable: no submitted inspection yet (a mistaken entry, not a quality record).
func (d WOShowData) deletable() bool {
	for _, i := range d.Inspections {
		if i.Status == gen.InspectionStatusSubmitted {
			return false
		}
	}
	return true
}

func (d WOShowData) hasDraft(stage string) int64 {
	for _, i := range d.Inspections {
		if string(i.Stage) == stage && i.Status == gen.InspectionStatusDraft {
			return i.ID
		}
	}
	return 0
}

templ WorkOrderShow(d WOShowData) {
	@App(t(ctx, "أمر العمل ") + d.WO.Ref) {
		<div class="mb-4 text-sm">
			<a href="/work-orders" class="text-ink-80 hover:text-ink">{ t(ctx, "أوامر العمل") }</a>
			<span class="text-ink-30 mx-1">/</span>
			<span class="num">{ d.WO.Ref }</span>
		</div>
		<section class="card p-5">
			<div class="flex flex-wrap items-start gap-3">
				<div class="min-w-0">
					<div class="flex flex-wrap items-center gap-2">
						<h1 class="text-xl font-semibold num">{ d.WO.Ref }</h1>
						@TypePill(string(d.WO.Type))
						@WOStatusPill(string(d.WO.Status))
						@PriorityPill(string(d.WO.Priority))
					</div>
					if d.WO.Description != "" {
						<p class="mt-2 text-ink-80 max-w-prose">{ d.WO.Description }</p>
					}
				</div>
				<div class="ms-auto flex flex-wrap gap-2">
					<a href={ u("/work-orders/%d/print", d.WO.ID) } class="btn btn-ghost" target="_blank" rel="noopener">
						@PrintIcon()
						{ t(ctx, "طباعة") }
					</a>
					if appctx.CanEdit(ctx) {
						<a href={ u("/work-orders/new?from=%d", d.WO.ID) } class="btn btn-ghost">{ t(ctx, "نسخ كأمر جديد") }</a>
						<a href={ u("/work-orders/%d/edit", d.WO.ID) } class="btn btn-outline">{ t(ctx, "تعديل") }</a>
					}
				</div>
			</div>
			<dl class="mt-5 grid gap-x-6 gap-y-4 grid-cols-2 md:grid-cols-4">
				@Fact(t(ctx, "الموقع")) {
					{ nm(ctx, d.WO.SiteName, d.WO.SiteNameEn) }
					if d.WO.Location != "" {
						<span class="block text-xs text-ink-80 font-normal">{ d.WO.Location }</span>
					}
				}
				@Fact(t(ctx, "المنظومة")) {
					{ nm(ctx, d.WO.SystemName, d.WO.SystemNameEn) }
					<span class="block text-xs text-ink-80 font-normal">{ t(ctx, "مجموعة الأصل: ") + nm(ctx, d.WO.AssetGroupName, d.WO.AssetGroupNameEn) }</span>
				}
				@Fact(t(ctx, "الأصل / المعدة")) {
					{ orDash(d.WO.Asset) }
				}
				@Fact(t(ctx, "المقاول")) {
					{ orDash(nm(ctx, d.WO.ContractorName, d.WO.ContractorNameEn)) }
					if d.WO.Technician != "" {
						<span class="block text-xs text-ink-80 font-normal">{ t(ctx, "الفني: ") + d.WO.Technician }</span>
					}
				}
				@Fact(tern(d.WO.Type == gen.WoTypeWO, t(ctx, "استحقاق SLA"), t(ctx, "التاريخ المجدول"))) {
					@DateText(d.WO.PlannedDate)
				}
				@Fact(t(ctx, "التنفيذ الفعلي")) {
					@DateText(d.WO.ActualDate)
				}
				@Fact(t(ctx, "الالتزام بالموعد")) {
					{ delayText(ctx, d.WO.PlannedDate, d.WO.ActualDate) }
					<span class="block mt-1">
						@SLAPill(slaState(d.WO.PlannedDate, d.WO.ActualDate, string(d.WO.Status)))
					</span>
				}
				@Fact(t(ctx, "تاريخ البلاغ")) {
					@DateText(&d.WO.ReportedOn)
				}
				@Fact(t(ctx, "أُنشئ")) {
					<span class="num">{ dateTime(d.WO.CreatedAt) }</span>
					if d.WO.CreatedByName != "" {
						<span class="block text-xs text-ink-80 font-normal">{ d.WO.CreatedByName }</span>
					}
				}
			</dl>
			if appctx.IsAdmin(ctx) && d.deletable() {
				<div class="mt-5 border-t border-ink-10 pt-3" x-data="confirmAction">
					<button type="button" class="btn btn-ghost text-fail px-2" x-on:click="ask" x-show="!asking">{ t(ctx, "حذف أمر العمل") }</button>
					<form method="post" action={ u("/work-orders/%d/delete", d.WO.ID) } x-show="asking" x-cloak class="flex flex-wrap items-center gap-2">
						<span class="text-sm">{ t(ctx, "حذف أمر العمل نهائياً مع مسوداته وملاحظاته وصوره؟ استخدمه فقط لما أُدخل بالخطأ.") }</span>
						<button type="submit" class="btn btn-danger">{ t(ctx, "نعم، احذف") }</button>
						<button type="button" class="btn btn-ghost" x-on:click="cancel">{ t(ctx, "تراجع") }</button>
					</form>
				</div>
			}
		</section>
		<div class="mt-5 grid gap-5 lg:grid-cols-5">
			<section class="lg:col-span-3">
				<div class="flex items-center gap-2 mb-3">
					<h2 class="font-semibold">{ t(ctx, "الفحوصات") }</h2>
					<span class="text-xs text-ink-60">{ t(ctx, "أثناء التنفيذ ← بعد التنفيذ") }</span>
				</div>
				if appctx.CanEdit(ctx) && d.WO.Status != gen.WoStatusCancelled {
					<div class="grid gap-3 sm:grid-cols-2 mb-4">
						@startCard(d, "during", t(ctx, "فحص أثناء التنفيذ"), t(ctx, "مرافقة المقاول أثناء العمل: السلامة، الإجراء، المواد، كفاءة الفني."))
						@startCard(d, "after", t(ctx, "فحص بعد التنفيذ"), t(ctx, "التحقق من النتيجة: جودة العمل، القراءات، التوثيق، النظافة، الإغلاق."))
					</div>
				}
				if len(d.Inspections) == 0 {
					<div class="card">
						@EmptyState(t(ctx, "لم يُسجَّل أي فحص بعد"), t(ctx, "ابدأ بفحص أثناء التنفيذ إن كان العمل جارياً، أو بفحص بعد التنفيذ إن انتهى."))
					</div>
				} else {
					<ol class="relative border-s-2 border-ink-10 ms-3 space-y-3">
						for _, in := range d.Inspections {
							<li class="ps-5 relative">
								<span
									class={ "absolute -start-[9px] top-4 size-4 rounded-full border-2 border-white",
										templ.KV("bg-sky", in.Stage == gen.InspectionStageDuring),
										templ.KV("bg-gold", in.Stage == gen.InspectionStageAfter) }
								></span>
								<a href={ u("/inspections/%d", in.ID) } class="card p-4 flex flex-wrap items-center gap-x-4 gap-y-2 hover:border-gold-50 transition-colors">
									<div class="flex items-center gap-2">
										@StagePill(string(in.Stage))
										if in.Attempt > 1 {
											<span class="pill bg-ink-5 text-ink-80">{ fmt.Sprintf(t(ctx, "محاولة %d"), in.Attempt) }</span>
										}
									</div>
									<div class="text-xs text-ink-80">
										@DateInline(in.InspectedOn)
										{ " · " + in.InspectorName }
									</div>
									<div class="ms-auto flex items-center gap-2">
										if in.FindingsCount > 0 {
											<span class="text-xs text-ink-80">{ count(ctx, int(in.FindingsCount), domain.NounFinding) }</span>
										}
										@ResultPill(in.Score, in.Passed, in.CriticalFailed)
									</div>
								</a>
							</li>
						}
					</ol>
				}
			</section>
			<section class="lg:col-span-2 space-y-5">
				if !appctx.IsContractor(ctx) {
					@assignmentsCard(d)
				}
				<div>
					<div class="flex items-center gap-2 mb-3">
						<h2 class="font-semibold">{ t(ctx, "الملاحظات والإجراءات التصحيحية") }</h2>
					</div>
					@FindingsCards(d.Findings, d.Today)
				</div>
				if !appctx.IsContractor(ctx) {
					<details class="card p-4">
						<summary class="font-semibold text-sm cursor-pointer">{ t(ctx, "السجل") } <span class="text-ink-60 font-normal num">{ itoa(len(d.History)) }</span></summary>
						<div class="mt-3">
							@HistoryList(d.History, true)
						</div>
					</details>
				}
			</section>
		</div>
	}
}

templ startCard(d WOShowData, stage, title, hint string) {
	<div class={ "card p-4 border-t-4", templ.KV("border-t-sky", stage == "during"), templ.KV("border-t-gold", stage == "after") }>
		<div class="flex items-center gap-2">
			<span class="font-semibold">{ title }</span>
		</div>
		<p class="text-xs text-ink-80 mt-1 mb-3">{ hint }</p>
		if draft := d.hasDraft(stage); draft != 0 {
			<a href={ u("/inspections/%d", draft) } class="btn btn-gold w-full">{ t(ctx, "متابعة المسودة") }</a>
		} else {
			<form method="post" action={ u("/work-orders/%d/inspections", d.WO.ID) }>
				<input type="hidden" name="stage" value={ stage }/>
				<button type="submit" class={ "btn w-full", templ.KV("btn-primary", stage == "during"), templ.KV("btn-gold", stage == "after") }>
					{ tern(stage == "during", t(ctx, "بدء فحص أثناء التنفيذ"), t(ctx, "بدء فحص بعد التنفيذ")) }
				</button>
			</form>
		}
	</div>
}

// FindingsCards lists findings as compact cards (work order + inspection pages).
templ FindingsCards(items []gen.ListFindingsByWorkOrderRow, today string) {
	if len(items) == 0 {
		<div class="card">
			@EmptyState(t(ctx, "لا توجد ملاحظات"), "")
		</div>
	} else {
		<ul class="space-y-3">
			for _, f := range items {
				<li class="card p-4">
					<div class="flex flex-wrap items-center gap-2">
						@FindingStatusPill(string(f.Status), f.Status != gen.FindingStatusClosed && f.DueDate != nil && isoDate(f.DueDate) < today)
						@SeverityPill(string(f.Severity))
						if f.RepeatOf != nil {
							<span class="pill bg-fail-10 text-fail" title={ t(ctx, "نفس البند على نفس الأصل خلال 90 يوماً") }>{ t(ctx, "متكررة") }</span>
						}
						if f.CriterionCode != "" {
							<span class="text-xs text-ink-60">{ f.CriterionCode + " · " + nm(ctx, f.CriterionLabel, f.CriterionLabelEn) }</span>
						}
						if f.InspectionStage != "" {
							<span class="text-xs text-ink-60 ms-auto">{ fmt.Sprintf(t(ctx, "%s · محاولة %d"), t(ctx, domain.Stage(f.InspectionStage).Short()), f.InspectionAttempt) }</span>
						}
					</div>
					<p class="mt-2">{ f.Description }</p>
					<p class="mt-1 text-sm text-ink-80"><span class="text-ink-60">{ t(ctx, "الإجراء التصحيحي:") }</span> { f.CorrectiveAction }</p>
					<div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-ink-80">
						if f.Owner != "" {
							<span>{ t(ctx, "المسؤول: ") + f.Owner }</span>
						}
						if f.DueDate != nil {
							<span>
								{ t(ctx, "الإغلاق المستهدف: ") }
								@DateInline(*f.DueDate)
							</span>
						}
						if f.Status == gen.FindingStatusClosed && f.ClosureNote != "" {
							<span>{ t(ctx, "الإغلاق: ") + f.ClosureNote }</span>
						}
					</div>
					if f.ResponseNote != "" && f.Status != gen.FindingStatusClosed {
						<p class="mt-2 rounded-md bg-sky-15 px-2.5 py-1.5 text-sm"><span class="text-ink-60">{ t(ctx, "رد المقاول: ") }</span>{ f.ResponseNote }</p>
					}
					if f.RejectionNote != "" && f.Status == gen.FindingStatusOpen {
						<p class="mt-2 rounded-md bg-fail-10 px-2.5 py-1.5 text-sm text-fail">{ t(ctx, "لم يُقبل الرد: ") + f.RejectionNote }</p>
					}
					if appctx.CanEdit(ctx) {
						<div class="mt-3 flex gap-2">
							<a href={ u("/findings/%d/edit", f.ID) } class="btn btn-outline py-1 text-xs">
								if f.Status == gen.FindingStatusResponded {
									{ t(ctx, "تحقق من الرد") }
								} else {
									{ tern(f.Status == gen.FindingStatusClosed, t(ctx, "عرض"), t(ctx, "تحديث / إغلاق")) }
								}
							</a>
						</div>
					} else if appctx.IsContractor(ctx) {
						<div class="mt-3 flex gap-2">
							<a href={ u("/findings/%d/edit", f.ID) } class={ "btn py-1 text-xs", templ.KV("btn-primary", f.Status == gen.FindingStatusOpen || f.Status == gen.FindingStatusInProgress), templ.KV("btn-outline", f.Status != gen.FindingStatusOpen && f.Status != gen.FindingStatusInProgress) }>
								{ tern(f.Status == gen.FindingStatusOpen || f.Status == gen.FindingStatusInProgress, t(ctx, "الرد على الملاحظة"), t(ctx, "عرض")) }
							</a>
						</div>
					}
				</li>
			}
		</ul>
	}
}
