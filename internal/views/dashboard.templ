package views

import (
	"context"
	"fmt"
	"math"

	"github.com/HZamzami/kidana-quality/internal/domain"
)

type DashFilters struct {
	Stage, Type, Site, System, AssetGroup, Contractor, From, To, Result string
}

type DashboardData struct {
	S           domain.Summary
	Insights    []domain.Insight
	F           DashFilters
	Query       string // encoded filters, reused by print/export links
	Sites       []Option
	Systems     []Option
	AssetGroups []Option
	Contractors []Option
	Trend       []domain.MonthPoint
	Views       ViewsBar
}

var StageOptions = []Option{{"during", "أثناء التنفيذ"}, {"after", "بعد التنفيذ"}}
var TypeOptions = []Option{{"PM", "صيانة وقائية"}, {"WO", "أمر عمل"}}
var ResultOptions = []Option{{"pass", "مطابق"}, {"fail", "غير مطابق"}}

// Dashboard layout scales with data: one compact criteria card per stage (side
// by side, similar heights), then three equal-height summary cards.
templ Dashboard(d DashboardData) {
	@App(t(ctx, "لوحة المؤشرات")) {
		@PageHeader(t(ctx, "لوحة المؤشرات"), t(ctx, "أداء الفحص أثناء التنفيذ وبعده")) {
			<a class="btn btn-ghost" href="/">{ t(ctx, "إعادة ضبط الفلاتر") }</a>
			<a class="btn btn-outline" href={ templ.URL("/reports/print?" + d.Query) } target="_blank" rel="noopener">{ t(ctx, "تقرير للطباعة") }</a>
			<a class="btn btn-gold" href={ templ.URL("/reports/export.xlsx?" + d.Query) }>{ t(ctx, "تصدير Excel") }</a>
		}
		@SavedViewsBar(d.Views)
		<form
			class="card p-3 mb-5 grid grid-cols-2 md:grid-cols-3 xl:grid-cols-9 items-end gap-3 no-print"
			method="get"
			action="/"
			hx-get="/"
			hx-trigger="change"
			hx-target="#dash"
			hx-select="#dash"
			hx-swap="outerHTML"
			hx-push-url="true"
		>
			<!-- 9 cells: pairs on phone (contractor spans), 3×3 on tablet, one row wide; dates stay together -->
			@FilterSelect("stage", t(ctx, "المرحلة"), d.F.Stage, StageOptions)
			@FilterSelect("type", t(ctx, "النوع"), d.F.Type, TypeOptions)
			@FilterSelect("site", t(ctx, "الموقع"), d.F.Site, d.Sites)
			@FilterSelect("result", t(ctx, "النتيجة"), d.F.Result, ResultOptions)
			@FilterSelect("system", t(ctx, "المنظومة"), d.F.System, d.Systems)
			@FilterSelect("group", t(ctx, "مجموعة الأصل"), d.F.AssetGroup, d.AssetGroups)
			<div class="col-span-2 md:col-span-1 min-w-0">
				@FilterSelect("contractor", t(ctx, "المقاول"), d.F.Contractor, d.Contractors)
			</div>
			<div class="min-w-0">
				<label class="label" for="flt_from">{ t(ctx, "من تاريخ") }</label>
				<input class="input h-9 w-full" type="date" id="flt_from" name="from" value={ d.F.From }/>
			</div>
			<div class="min-w-0">
				<label class="label" for="flt_to">{ t(ctx, "إلى تاريخ") }</label>
				<input class="input h-9 w-full" type="date" id="flt_to" name="to" value={ d.F.To }/>
			</div>
			<noscript><button class="btn btn-primary">{ t(ctx, "تطبيق") }</button></noscript>
		</form>
		<div id="dash">
			@dashKPIs(d.S)
			<div class="mt-5 grid gap-4 lg:grid-cols-2">
				if d.F.Stage != "after" {
					@criteriaCard(domain.StageDuring, d.S.CriteriaFor(domain.StageDuring), d.F.Stage == "during")
				}
				if d.F.Stage != "during" {
					@criteriaCard(domain.StageAfter, d.S.CriteriaFor(domain.StageAfter), d.F.Stage == "after")
				}
			</div>
			<div class="mt-4 grid gap-4 md:grid-cols-3">
				<section class="card p-4">
					<h2 class="font-semibold mb-4">{ t(ctx, "متوسط النتيجة حسب الموقع") }</h2>
					@groupBars(d.S.BySite, 6)
				</section>
				<section class="card p-4">
					<h2 class="font-semibold mb-4">{ t(ctx, "توزيع التقديرات") }</h2>
					@gradeDonut(d.S.Grades)
				</section>
				<section class="card p-4">
					<h2 class="font-semibold mb-4">{ t(ctx, "حسب المقاول") }</h2>
					@groupBars(d.S.ByContractor, 6)
				</section>
			</div>
			<section class="mt-4 card p-4">
				<div class="flex flex-wrap items-baseline gap-2 mb-3">
					<h2 class="font-semibold">{ t(ctx, "الاتجاه الشهري") }</h2>
					<span class="text-xs text-ink-60">{ t(ctx, "متوسط النتيجة لكل شهر (آخر 12 شهراً)، والخط حد المطابقة") }</span>
				</div>
				@TrendChart(d.Trend)
			</section>
			<div class="mt-4">
				<section class="card p-4">
					<h2 class="font-semibold mb-3">{ t(ctx, "أبرز الملاحظات والتوصيات") }</h2>
					<ul class="grid gap-2 lg:grid-cols-2">
						for _, in := range d.Insights {
							<li
								class={ "rounded-lg border px-3 py-2.5 text-sm leading-relaxed",
									templ.KV("border-fail-20 bg-fail-10", in.Tone == "risk"),
									templ.KV("border-green-50 bg-green-10", in.Tone == "good"),
									templ.KV("border-ink-10 bg-ink-5", in.Tone == "info") }
							>{ in.Text }</li>
						}
					</ul>
				</section>
			</div>
		</div>
	}
}

templ dashKPIs(S domain.Summary) {
	<div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-3">
		@kpi(t(ctx, "الفحوصات المرسلة"), itoa(S.Total), fmt.Sprintf(t(ctx, "أثناء %d · بعد %d · %s"), S.DuringCount, S.AfterCount, count(ctx, S.WorkOrders, domain.NounWorkOrder)), "")
		@kpi(t(ctx, "متوسط أثناء التنفيذ"), domain.Pct(S.AvgDuring), t(ctx, "فحص أثناء التنفيذ"), "sky")
		@kpi(t(ctx, "متوسط بعد التنفيذ"), domain.Pct(S.AvgAfter), t(ctx, "فحص بعد التنفيذ"), "gold")
		@kpi(t(ctx, "نسبة المطابقة"), domain.Pct(S.PassRate), fmt.Sprintf(t(ctx, "حد المطابقة %s · %d إخفاق حرج"), domain.PctVal(domain.PassThreshold), S.CriticalFails), "green")
		@kpi(t(ctx, "ملاحظات مفتوحة"), itoa(S.Findings.Open), fmt.Sprintf(t(ctx, "متأخرة %d · حرجة %d"), S.Findings.Overdue, S.Findings.OpenCritical), tern(S.Findings.Overdue > 0, "fail", ""))
		@kpi(t(ctx, "الالتزام بالموعد"), domain.Pct(S.OnTimeRate), t(ctx, "متوسط التأخير ")+avgDelay(S.AvgDelay)+t(ctx, " يوم"), "")
	</div>
}

templ kpi(label, value, sub, tone string) {
	<div class="card p-4">
		<div class="flex items-center gap-2 text-xs text-ink-80">
			<span
				class={ "size-2 rounded-full",
					templ.KV("bg-ink-30", tone == ""),
					templ.KV("bg-sky", tone == "sky"),
					templ.KV("bg-gold", tone == "gold"),
					templ.KV("bg-green", tone == "green"),
					templ.KV("bg-fail", tone == "fail") }
			></span>
			{ label }
		</div>
		<div class="num text-2xl font-semibold mt-1.5 text-start">{ value }</div>
		<div class="text-[11px] text-ink-60 mt-1 leading-snug">{ sub }</div>
	</div>
}

templ barRow(label string, value float64, sub string, critical bool) {
	<div>
		<div class="flex items-baseline gap-2 text-sm">
			<span class="truncate">{ label }</span>
			if critical {
				<span class="pill border border-fail text-fail text-[10px] px-1.5">{ t(ctx, "حرج") }</span>
			}
			<span class="num ms-auto font-medium">{ scoreVal(value) }</span>
		</div>
		<div class="mt-1 h-2 rounded-full bg-ink-10 overflow-hidden">
			<div class={ "h-full rounded-full", templ.KV("bg-green", value >= domain.PassThreshold), templ.KV("bg-gold", value < domain.PassThreshold) } style={ pctWidth(value) }></div>
		</div>
		if sub != "" {
			<div class="text-[11px] text-ink-60 mt-0.5">{ sub }</div>
		}
	</div>
}

// groupBars shows the first max groups (best first) and a "+N" line for the rest.
templ groupBars(groups []domain.Group, max int) {
	if len(groups) == 0 {
		@EmptyState(t(ctx, "لا توجد بيانات"), "")
	} else {
		<div class="space-y-3">
			for _, g := range topN(groups, max) {
				@barRow(g.Name, g.Avg, count(ctx, g.Count, domain.NounInspection)+t(ctx, " · مطابقة ")+domain.PctVal(g.PassRate), false)
			}
		</div>
		if len(groups) > max {
			<p class="mt-3 text-xs text-ink-60">{ fmt.Sprintf(t(ctx, "و%d أخرى — راجع تقرير Excel للقائمة الكاملة"), len(groups)-max) }</p>
		}
	}
}

// criteriaCard is the per-criterion compliance of one stage. wide = the only
// card shown (stage filter set), so its rows flow into two columns.
templ criteriaCard(stage domain.Stage, items []domain.CriterionStat, wide bool) {
	<section class={ "card p-4", templ.KV("lg:col-span-2", wide) }>
		<div class="flex flex-wrap items-baseline gap-x-2 mb-3">
			<h2 class="font-semibold">{ t(ctx, "نسبة المطابقة لكل معيار") }</h2>
			@StagePill(string(stage))
			<p class="w-full text-xs text-ink-60 mt-0.5">{ t(ctx, "المطابق 100%، الجزئي 50%، و«لا ينطبق» مستبعد.") }<span class="hidden sm:inline">{ t(ctx, "مرّر المؤشر على البند للتفاصيل.") }</span></p>
		</div>
		if len(items) == 0 {
			@EmptyState(t(ctx, "لا توجد فحوصات مرسلة لهذه المرحلة ضمن النطاق"), "")
		} else {
			<div class={ "grid gap-y-2.5", templ.KV("lg:grid-cols-2 lg:gap-x-8", wide) }>
				for _, c := range items {
					@compactBarRow(c)
				}
			</div>
		}
	</section>
}

// compactBarRow: label, bar and value on one line from sm up (details in the
// tooltip). On phones, where there is no hover, the full label wraps with the
// value beside it and the bar runs full width underneath.
templ compactBarRow(c domain.CriterionStat) {
	<div
		class="grid grid-cols-[minmax(0,1fr)_3.25rem] sm:grid-cols-[minmax(0,1fr)_minmax(5rem,38%)_3.25rem] items-center gap-x-3 gap-y-1 text-sm"
		title={ c.Code + " · " + c.Label + " — " + count(ctx, c.N, domain.NounRating) + t(ctx, " · غير مطابق: ") + itoa(c.Fails) }
	>
		<div class="flex items-center gap-1.5 min-w-0">
			<span class="num text-xs text-ink-60 shrink-0">{ c.Code }</span>
			<span class="sm:truncate print:whitespace-normal print:overflow-visible">{ c.Label }</span>
			if c.Critical {
				<span class="pill border border-fail text-fail text-[10px] px-1.5 shrink-0">{ t(ctx, "حرج") }</span>
			}
			if c.Fails > 0 {
				<span class="text-[11px] text-fail shrink-0 whitespace-nowrap">{ fmt.Sprintf("✕ %d", c.Fails) }</span>
			}
		</div>
		<div class="order-3 col-span-2 sm:order-none sm:col-span-1 h-2 rounded-full bg-ink-10 overflow-hidden">
			<div class={ "h-full rounded-full", templ.KV("bg-green", c.Compliance >= domain.PassThreshold), templ.KV("bg-gold", c.Compliance < domain.PassThreshold) } style={ pctWidth(c.Compliance) }></div>
		</div>
		<span class="order-2 sm:order-none num font-medium text-end">{ scoreVal(c.Compliance) }</span>
	</div>
}

var gradeColors = []string{"#627D4C", "#93BBCA", "#B59666", "#DACBB3", "#94959A"}

templ gradeDonut(grades []domain.GradeCount) {
	if gradeTotal(grades) == 0 {
		@EmptyState(t(ctx, "لا توجد بيانات"), "")
	} else {
		<div class="flex items-center gap-4">
			<svg viewBox="0 0 42 42" class="size-28 shrink-0 -rotate-90" role="img" aria-label={ t(ctx, "توزيع التقديرات") }>
				<circle cx="21" cy="21" r="15.915" fill="none" stroke="#EDEDEE" stroke-width="6"></circle>
				for i, seg := range donutSegments(grades) {
					if seg.len > 0 {
						<circle cx="21" cy="21" r="15.915" fill="none" stroke={ gradeColors[i] } stroke-width="6" stroke-dasharray={ fmt.Sprintf("%.2f %.2f", seg.len, 100-seg.len) } stroke-dashoffset={ fmt.Sprintf("%.2f", -seg.offset) }></circle>
					}
				}
			</svg>
			<ul class="text-sm space-y-1 min-w-0">
				for i, g := range grades {
					<li class="flex items-center gap-2">
						<span class="size-2.5 rounded-sm shrink-0" style={ "background:" + gradeColors[i] }></span>
						<span class="truncate">{ t(ctx, g.Label) }</span>
						<span class="num text-ink-80 ms-auto ps-3">{ itoa(g.Count) }</span>
					</li>
				}
			</ul>
		</div>
	}
}

type donutSeg struct{ len, offset float64 }

func donutSegments(grades []domain.GradeCount) []donutSeg {
	total := float64(gradeTotal(grades))
	out := make([]donutSeg, len(grades))
	var off float64
	for i, g := range grades {
		l := float64(g.Count) / total * 100
		out[i] = donutSeg{len: math.Round(l*100) / 100, offset: off}
		off += l
	}
	return out
}

func gradeTotal(gs []domain.GradeCount) int {
	n := 0
	for _, g := range gs {
		n += g.Count
	}
	return n
}

func topN(gs []domain.Group, n int) []domain.Group {
	if len(gs) > n {
		return gs[:n]
	}
	return gs
}

func avgDelay(v *float64) string {
	if v == nil {
		return "—"
	}
	return domain.Fmt1(*v)
}

func tern(cond bool, a, b string) string {
	if cond {
		return a
	}
	return b
}

// TrendChart shows monthly average score as bars (oldest first in reading
// order) with the pass mark as a line. Bars are tinted pass or fail.
templ TrendChart(points []domain.MonthPoint) {
	<div class="relative">
		<div class="absolute inset-x-0 border-t border-dashed border-fail/60 pointer-events-none" style={ fmt.Sprintf("bottom:calc(1.5rem + %.1f%% * 0.85)", domain.PassThreshold) }></div>
		<div class="flex items-end gap-1 sm:gap-2 h-44">
			for _, p := range points {
				<div class="flex-1 min-w-0 h-full flex flex-col justify-end items-center" title={ trendTitle(ctx, p) }>
					if p.Count > 0 {
						<span class="text-[10px] num text-ink-80 mb-0.5">{ domain.Fmt1(p.Avg) }</span>
						<span class={ "w-full max-w-10 rounded-t", templ.KV("bg-green-50", p.Avg >= domain.PassThreshold), templ.KV("bg-fail/40", p.Avg < domain.PassThreshold) } style={ fmt.Sprintf("height:%.1f%%", p.Avg*0.85) }></span>
					} else {
						<span class="w-full max-w-10 h-px bg-ink-10"></span>
					}
					<span class="mt-1 h-5 text-[10px] num text-ink-60">{ p.Month[5:] + "/" + p.Month[2:4] }</span>
				</div>
			}
		</div>
	</div>
}

func trendTitle(ctx context.Context, p domain.MonthPoint) string {
	if p.Count == 0 {
		return p.Month
	}
	return fmt.Sprintf("%s — %s · %s", p.Month, count(ctx, p.Count, domain.NounInspection), domain.PctVal(p.PassRate))
}
