# Copy to .env to override defaults. compose.yaml already sets DATABASE_URL etc. for local dev.

# First-run admin account. Created only when the users table is empty.
ADMIN_EMAIL=admin@kidana.local
ADMIN_NAME=مدير النظام
ADMIN_PASSWORD=change-me-now

# Host ports (used by compose)
# APP_PORT=8080
# DB_PORT=5432

# Production only
# SESSION_SECURE=true          # cookies only over HTTPS
# SESSION_LIFETIME=12h
# MAX_UPLOAD_MB=10

# Microsoft sign-in (Entra ID) or any OpenID Connect provider. Off unless all
# four are set. Users must already exist with the same email; there is no
# automatic account creation.
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://quality.example.com/auth/oidc/callback
# OIDC_LABEL=Microsoft
